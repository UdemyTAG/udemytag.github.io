---
interface Props {
  totalCourses: number;
  totalClaimed?: number;
}

const { totalCourses = 80, totalClaimed = 41900 } = Astro.props;
---

<section class="relative overflow-hidden pt-6 pb-8 sm:pt-12 sm:pb-14 bg-gradient-to-b from-rose-50/60 via-white to-transparent dark:from-rose-950/20 dark:via-slate-950 dark:to-transparent border-b border-slate-200/60 dark:border-slate-800/60">
  
  <!-- Subtle Background decorative glows -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-6xl h-64 bg-gradient-to-tr from-rose-500/10 via-amber-500/10 to-transparent blur-3xl pointer-events-none -z-10"></div>
  <div class="absolute -top-24 left-1/4 w-80 h-80 bg-rose-500/5 rounded-full blur-2xl pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <!-- Top Pill: Clean & User-Centric with Total Claimed Metrics -->
    <div class="inline-flex items-center gap-2 px-3 py-1 sm:px-3.5 sm:py-1.5 rounded-full text-[11px] sm:text-xs font-semibold bg-white dark:bg-slate-900 border border-rose-200/80 dark:border-rose-900/50 shadow-sm text-rose-700 dark:text-rose-300 mb-4 sm:mb-6">
      <span class="flex h-2 w-2 rounded-full bg-rose-500 animate-pulse"></span>
      <span class="font-extrabold text-rose-600 dark:text-rose-400">🔥 <span class="hero-total-claimed-num" data-base={totalClaimed}>{totalClaimed.toLocaleString()}</span>+</span>
      <span class="text-slate-300 dark:text-slate-700">|</span>
      <span class="font-bold" data-i18n="hero_pill">Kupon Telah Diklaim</span>
    </div>

    <!-- Main Headline: Compact on Mobile -->
    <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white max-w-3xl mx-auto leading-tight" data-i18n="hero_headline">
      Kupon Diskon <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-600 via-rose-500 to-amber-500">100% Gratis</span> Kursus Udemy
    </h1>

    <!-- Subtitle / Value Proposition -->
    <p class="mt-2.5 sm:mt-4 text-xs sm:text-base text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed" data-i18n="hero_subtitle">
      Akses materi pembelajaran premium dari instruktur Udemy terkemuka. Lengkap dengan sertifikat kelulusan resmi dan hak akses seumur hidup tanpa biaya sepeser pun.
    </p>

    <!-- Key Highlights / Feature Badges: 5 items responsive -->
    <div class="mt-5 sm:mt-7 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2 sm:gap-3 max-w-4xl mx-auto text-left">
      
      <!-- 1. Total Kupon Diklaim -->
      <div class="flex items-center gap-2 sm:gap-3 p-2.5 sm:p-3 rounded-xl sm:rounded-2xl bg-white dark:bg-slate-900 border border-rose-200/80 dark:border-rose-900/50 shadow-sm">
        <div class="p-1.5 sm:p-2 rounded-lg sm:rounded-xl bg-rose-50 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400">
          <svg class="w-4 h-4 sm:w-5 sm:h-5 fill-current text-rose-500 animate-pulse" viewBox="0 0 24 24">
            <path d="M12 2c-.5 2.5-2.5 4.5-4 6-2 2-3 4.5-3 7 0 5 4 9 9 9s9-4 9-9c0-3.5-2-6-4.5-8-1-1-2-2.5-2.5-5-.5 1-1.5 2-4 2z"/>
          </svg>
        </div>
        <div>
          <div class="text-xs sm:text-sm font-extrabold text-slate-900 dark:text-white">
            <span class="hero-highlight-claimed-num" data-base={totalClaimed}>{Math.round(totalClaimed / 1000)}k+</span>
          </div>
          <div class="text-[10px] sm:text-[11px] text-slate-500 dark:text-slate-400" data-i18n="badge_claimed_title">Klaim Sukses</div>
        </div>
      </div>

      <!-- 2. Kursus Aktif -->
      <div class="flex items-center gap-2 sm:gap-3 p-2.5 sm:p-3 rounded-xl sm:rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm">
        <div class="p-1.5 sm:p-2 rounded-lg sm:rounded-xl bg-rose-50 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400">
          <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        </div>
        <div>
          <div class="text-xs sm:text-sm font-extrabold text-slate-900 dark:text-white">{totalCourses}+ Kursus</div>
          <div class="text-[10px] sm:text-[11px] text-slate-500 dark:text-slate-400" data-i18n="badge_available">Tersedia</div>
        </div>
      </div>

      <!-- 3. Legal -->
      <div class="flex items-center gap-2 sm:gap-3 p-2.5 sm:p-3 rounded-xl sm:rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm">
        <div class="p-1.5 sm:p-2 rounded-lg sm:rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400">
          <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <div class="text-xs sm:text-sm font-extrabold text-slate-900 dark:text-white" data-i18n="badge_legal_title">100% Legal</div>
          <div class="text-[10px] sm:text-[11px] text-slate-500 dark:text-slate-400" data-i18n="badge_legal_sub">Resmi Instruktur</div>
        </div>
      </div>

      <!-- 4. Sertifikat -->
      <div class="flex items-center gap-2 sm:gap-3 p-2.5 sm:p-3 rounded-xl sm:rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm">
        <div class="p-1.5 sm:p-2 rounded-lg sm:rounded-xl bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400">
          <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <div>
          <div class="text-xs sm:text-sm font-extrabold text-slate-900 dark:text-white" data-i18n="badge_cert_title">Sertifikat</div>
          <div class="text-[10px] sm:text-[11px] text-slate-500 dark:text-slate-400" data-i18n="badge_cert_sub">Kelulusan Resmi</div>
        </div>
      </div>

      <!-- 5. Lifetime -->
      <div class="flex items-center gap-2 sm:gap-3 p-2.5 sm:p-3 rounded-xl sm:rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm col-span-2 sm:col-span-1">
        <div class="p-1.5 sm:p-2 rounded-lg sm:rounded-xl bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400">
          <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <div class="text-xs sm:text-sm font-extrabold text-slate-900 dark:text-white" data-i18n="badge_life_title">Lifetime</div>
          <div class="text-[10px] sm:text-[11px] text-slate-500 dark:text-slate-400" data-i18n="badge_life_sub">Akses Selamanya</div>
        </div>
      </div>

    </div>

  </div>
</section>
