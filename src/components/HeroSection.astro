---
interface Props {
  totalCourses: number;
  lastUpdated?: string;
}

const { 
  totalCourses = 80, 
  lastUpdated = 'Diperbarui otomatis tiap 6 jam' 
} = Astro.props;
---

<section class="relative overflow-hidden pt-10 pb-12 sm:pt-14 sm:pb-16 bg-gradient-to-b from-rose-50/50 via-white to-transparent dark:from-rose-950/20 dark:via-slate-950 dark:to-transparent border-b border-slate-200/60 dark:border-slate-800/60">
  
  <!-- Subtle Background decorative glows -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-6xl h-72 bg-gradient-to-tr from-rose-500/10 via-amber-500/10 to-transparent blur-3xl pointer-events-none -z-10"></div>
  <div class="absolute -top-24 left-1/4 w-96 h-96 bg-rose-500/5 rounded-full blur-2xl pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <!-- Top Pill: Pipeline & Status -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold bg-white dark:bg-slate-900 border border-rose-200/80 dark:border-rose-900/50 shadow-sm shadow-rose-500/5 text-rose-700 dark:text-rose-300 mb-6 animate-pulse-subtle">
      <span class="flex h-2 w-2 rounded-full bg-rose-500"></span>
      <span class="font-bold">Automated Sheets Pipeline:</span>
      <span class="text-slate-600 dark:text-slate-400 font-normal">{lastUpdated}</span>
    </div>

    <!-- Main Headline -->
    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white max-w-4xl mx-auto leading-tight sm:leading-tight">
      Kupon Diskon <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-600 via-rose-500 to-amber-500">100% Gratis</span> & Legal Kursus Udemy
    </h1>

    <!-- Subtitle / Value Proposition -->
    <p class="mt-4 sm:mt-5 text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed">
      Akses materi pembelajaran teknologi, bisnis, dan desain premium dari instruktur Udemy terkemuka. Lengkap dengan sertifikat kelulusan resmi dan hak akses seumur hidup tanpa biaya sepeser pun.
    </p>

    <!-- Key Highlights / Feature Badges -->
    <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 max-w-3xl mx-auto text-left">
      
      <div class="flex items-center gap-3 p-3 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm">
        <div class="p-2 rounded-xl bg-rose-50 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        </div>
        <div>
          <div class="text-sm font-extrabold text-slate-900 dark:text-white">{totalCourses}+ Kursus</div>
          <div class="text-[11px] text-slate-500 dark:text-slate-400">Tersedia Saat Ini</div>
        </div>
      </div>

      <div class="flex items-center gap-3 p-3 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm">
        <div class="p-2 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <div class="text-sm font-extrabold text-slate-900 dark:text-white">100% Legal</div>
          <div class="text-[11px] text-slate-500 dark:text-slate-400">Kupon Resmi Instruktur</div>
        </div>
      </div>

      <div class="flex items-center gap-3 p-3 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm">
        <div class="p-2 rounded-xl bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <div>
          <div class="text-sm font-extrabold text-slate-900 dark:text-white">Sertifikat</div>
          <div class="text-[11px] text-slate-500 dark:text-slate-400">Kelulusan Resmi</div>
        </div>
      </div>

      <div class="flex items-center gap-3 p-3 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm">
        <div class="p-2 rounded-xl bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <div class="text-sm font-extrabold text-slate-900 dark:text-white">Lifetime</div>
          <div class="text-[11px] text-slate-500 dark:text-slate-400">Akses Selamanya</div>
        </div>
      </div>

    </div>

  </div>
</section>
