---
interface Props {
  totalCourses: number;
  totalActiveFree?: number;
  totalSubscribers?: number;
}

const { 
  totalCourses = 69, 
  totalActiveFree = 42, 
  totalSubscribers = 1450000 
} = Astro.props;

const subsFormatted = totalSubscribers >= 1000000 
  ? `${(totalSubscribers / 1000000).toFixed(1)}M+` 
  : `${Math.round(totalSubscribers / 1000)}k+`;
---

<section class="relative overflow-hidden pt-8 pb-10 sm:pt-14 sm:pb-16 bg-gradient-to-b from-slate-50/70 via-white to-transparent dark:from-slate-950 dark:via-slate-900/50 dark:to-slate-950 border-b border-slate-200/60 dark:border-slate-800/60">
  
  <!-- Dynamic Animated Ambient Background Layer -->
  <div class="hero-bg-layer absolute inset-0 pointer-events-none overflow-hidden -z-10" aria-hidden="true">
    
    <!-- 1. Floating Glowing Ambient Orbs (Multi-color Aurora) -->
    <div class="hero-orb orb-1 absolute -top-28 -left-24 w-80 h-80 sm:w-[32rem] sm:h-[32rem] bg-gradient-to-tr from-rose-600/25 via-pink-500/20 to-transparent rounded-full blur-3xl"></div>
    <div class="hero-orb orb-2 absolute top-0 -right-24 w-80 h-80 sm:w-[30rem] sm:h-[30rem] bg-gradient-to-bl from-indigo-600/20 via-purple-600/15 to-transparent rounded-full blur-3xl"></div>
    <div class="hero-orb orb-3 absolute top-1/4 left-1/2 -translate-x-1/2 w-72 h-72 sm:w-[28rem] sm:h-[28rem] bg-gradient-to-r from-amber-500/15 via-rose-500/15 to-transparent rounded-full blur-3xl"></div>
    <div class="hero-orb orb-4 absolute -bottom-20 left-1/3 w-64 h-64 sm:w-80 sm:h-80 bg-emerald-500/10 rounded-full blur-3xl"></div>

    <!-- 2. Cyber Dot Matrix Grid with Radial Mask -->
    <div class="hero-grid-pattern absolute inset-0 bg-[radial-gradient(#e11d48_1px,transparent_1px)] dark:bg-[radial-gradient(#f43f5e_1px,transparent_1px)] [background-size:26px_26px] opacity-[0.07] dark:opacity-[0.14] [mask-image:radial-gradient(ellipse_75%_65%_at_50%_45%,#000_20%,transparent_100%)]"></div>

    <!-- 3. Floating Light Sparkles / Particles -->
    <div class="hero-particle particle-1 absolute top-1/4 left-[15%] w-1.5 h-1.5 rounded-full bg-rose-400 dark:bg-rose-300 shadow-sm shadow-rose-400"></div>
    <div class="hero-particle particle-2 absolute top-1/3 right-[20%] w-2 h-2 rounded-full bg-amber-400 dark:bg-amber-300 shadow-sm shadow-amber-400"></div>
    <div class="hero-particle particle-3 absolute top-1/2 left-[28%] w-1.5 h-1.5 rounded-full bg-purple-400 dark:bg-purple-300 shadow-sm shadow-purple-400"></div>
    <div class="hero-particle particle-4 absolute top-2/3 right-[15%] w-2 h-2 rounded-full bg-rose-400 dark:bg-rose-300 shadow-sm shadow-rose-400"></div>
    <div class="hero-particle particle-5 absolute top-[18%] right-[32%] w-1.5 h-1.5 rounded-full bg-emerald-400 dark:bg-emerald-300 shadow-sm shadow-emerald-400"></div>
    <div class="hero-particle particle-6 absolute bottom-1/4 left-[22%] w-1.5 h-1.5 rounded-full bg-amber-400 dark:bg-amber-300 shadow-sm shadow-amber-400"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    
    <!-- Top Pill: Clean & 100% Real Verification -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-[11px] sm:text-xs font-semibold bg-white/90 dark:bg-slate-900/90 backdrop-blur-md border border-emerald-200/80 dark:border-emerald-900/50 shadow-sm text-emerald-700 dark:text-emerald-300 mb-4 sm:mb-6 transition-transform hover:scale-105">
      <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span class="font-extrabold text-emerald-600 dark:text-emerald-400">✓ <span>{totalActiveFree}</span> <span data-i18n="hero_pill_badge">Kupon Gratis</span></span>
      <span class="text-slate-300 dark:text-slate-700">|</span>
      <span class="font-bold" data-i18n="hero_pill">Terverifikasi Aktif Hari Ini</span>
    </div>

    <!-- Main Headline with Dynamic Typewriter Effect -->
    <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white max-w-4xl mx-auto leading-tight sm:leading-snug">
      <span data-i18n="hero_headline_lead">Kupon Diskon Kursus Udemy</span>
      <span class="block mt-1 sm:mt-2 text-transparent bg-clip-text bg-gradient-to-r from-rose-600 via-rose-500 to-amber-500 min-h-[1.3em]">
        <span id="hero-typewriter">100% Gratis Selamanya</span><span id="typewriter-cursor" class="inline-block text-rose-500 dark:text-rose-400 font-light ml-0.5 animate-pulse">|</span>
      </span>
    </h1>

    <!-- Subtitle / Value Proposition -->
    <p class="mt-3 sm:mt-4 text-xs sm:text-base text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed" data-i18n="hero_subtitle">
      Akses materi pembelajaran premium dari instruktur Udemy terkemuka. Lengkap dengan sertifikat kelulusan resmi dan hak akses seumur hidup tanpa biaya sepeser pun.
    </p>

    <!-- Key Highlights / Feature Badges: 100% RATA TENGAH (Centered) di Semua Layar -->
    <div class="mt-6 sm:mt-8 flex flex-wrap items-center justify-center gap-2.5 sm:gap-3.5 max-w-5xl mx-auto">
      
      <!-- 1. Total Siswa Belajar di Udemy (Data Riil Asli) -->
      <div class="flex items-center gap-2 sm:gap-2.5 p-2.5 sm:p-3 rounded-xl sm:rounded-2xl bg-white/90 dark:bg-slate-900/80 backdrop-blur-md border border-slate-200/80 dark:border-slate-800/80 shadow-sm hover:border-blue-400/50 dark:hover:border-blue-500/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 w-[calc(50%-0.4rem)] sm:w-[calc(33.333%-0.6rem)] lg:w-auto lg:flex-1 min-w-[140px] sm:min-w-[155px] max-w-[200px] text-left">
        <div class="p-1.5 sm:p-2 rounded-lg sm:rounded-xl bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex-shrink-0">
          <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </div>
        <div class="min-w-0">
          <div class="text-xs sm:text-sm font-extrabold text-slate-900 dark:text-white truncate">
            <span>{subsFormatted}</span>
          </div>
          <div class="text-[10px] sm:text-[11px] text-slate-500 dark:text-slate-400 truncate" data-i18n="badge_students_title">Siswa Belajar</div>
        </div>
      </div>

      <!-- 2. Kupon 100% Free Aktif Terverifikasi -->
      <div class="flex items-center gap-2 sm:gap-2.5 p-2.5 sm:p-3 rounded-xl sm:rounded-2xl bg-white/90 dark:bg-slate-900/80 backdrop-blur-md border border-slate-200/80 dark:border-slate-800/80 shadow-sm hover:border-emerald-400/50 dark:hover:border-emerald-500/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 w-[calc(50%-0.4rem)] sm:w-[calc(33.333%-0.6rem)] lg:w-auto lg:flex-1 min-w-[140px] sm:min-w-[155px] max-w-[200px] text-left">
        <div class="p-1.5 sm:p-2 rounded-lg sm:rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex-shrink-0">
          <svg class="w-4 h-4 sm:w-5 sm:h-5 fill-current animate-pulse" viewBox="0 0 24 24">
            <path d="M12 2c-.5 2.5-2.5 4.5-4 6-2 2-3 4.5-3 7 0 5 4 9 9 9s9-4 9-9c0-3.5-2-6-4.5-8-1-1-2-2.5-2.5-5-.5 1-1.5 2-4 2z"/>
          </svg>
        </div>
        <div class="min-w-0">
          <div class="text-xs sm:text-sm font-extrabold text-slate-900 dark:text-white truncate">{totalActiveFree} Kupon</div>
          <div class="text-[10px] sm:text-[11px] text-slate-500 dark:text-slate-400 truncate" data-i18n="badge_available">Aktif Hari Ini</div>
        </div>
      </div>

      <!-- 3. Total Kursus -->
      <div class="flex items-center gap-2 sm:gap-2.5 p-2.5 sm:p-3 rounded-xl sm:rounded-2xl bg-white/90 dark:bg-slate-900/80 backdrop-blur-md border border-slate-200/80 dark:border-slate-800/80 shadow-sm hover:border-rose-400/50 dark:hover:border-rose-500/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 w-[calc(50%-0.4rem)] sm:w-[calc(33.333%-0.6rem)] lg:w-auto lg:flex-1 min-w-[140px] sm:min-w-[155px] max-w-[200px] text-left">
        <div class="p-1.5 sm:p-2 rounded-lg sm:rounded-xl bg-rose-50 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 flex-shrink-0">
          <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        </div>
        <div class="min-w-0">
          <div class="text-xs sm:text-sm font-extrabold text-slate-900 dark:text-white truncate">{totalCourses}+ Kursus</div>
          <div class="text-[10px] sm:text-[11px] text-slate-500 dark:text-slate-400 truncate" data-i18n="badge_curated">Tersedia</div>
        </div>
      </div>

      <!-- 4. Legal Resmi -->
      <div class="flex items-center gap-2 sm:gap-2.5 p-2.5 sm:p-3 rounded-xl sm:rounded-2xl bg-white/90 dark:bg-slate-900/80 backdrop-blur-md border border-slate-200/80 dark:border-slate-800/80 shadow-sm hover:border-emerald-400/50 dark:hover:border-emerald-500/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 w-[calc(50%-0.4rem)] sm:w-[calc(33.333%-0.6rem)] lg:w-auto lg:flex-1 min-w-[140px] sm:min-w-[155px] max-w-[200px] text-left">
        <div class="p-1.5 sm:p-2 rounded-lg sm:rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex-shrink-0">
          <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="min-w-0">
          <div class="text-xs sm:text-sm font-extrabold text-slate-900 dark:text-white truncate" data-i18n="badge_legal_title">100% Legal</div>
          <div class="text-[10px] sm:text-[11px] text-slate-500 dark:text-slate-400 truncate" data-i18n="badge_legal_sub">Resmi Instruktur</div>
        </div>
      </div>

      <!-- 5. Sertifikat -->
      <div class="flex items-center gap-2 sm:gap-2.5 p-2.5 sm:p-3 rounded-xl sm:rounded-2xl bg-white/90 dark:bg-slate-900/80 backdrop-blur-md border border-slate-200/80 dark:border-slate-800/80 shadow-sm hover:border-blue-400/50 dark:hover:border-blue-500/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 w-[calc(50%-0.4rem)] sm:w-[calc(33.333%-0.6rem)] lg:w-auto lg:flex-1 min-w-[140px] sm:min-w-[155px] max-w-[200px] text-left">
        <div class="p-1.5 sm:p-2 rounded-lg sm:rounded-xl bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex-shrink-0">
          <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <div class="min-w-0">
          <div class="text-xs sm:text-sm font-extrabold text-slate-900 dark:text-white truncate" data-i18n="badge_cert_title">Sertifikat</div>
          <div class="text-[10px] sm:text-[11px] text-slate-500 dark:text-slate-400 truncate" data-i18n="badge_cert_sub">Kelulusan Resmi</div>
        </div>
      </div>

      <!-- 6. Lifetime -->
      <div class="flex items-center gap-2 sm:gap-2.5 p-2.5 sm:p-3 rounded-xl sm:rounded-2xl bg-white/90 dark:bg-slate-900/80 backdrop-blur-md border border-slate-200/80 dark:border-slate-800/80 shadow-sm hover:border-amber-400/50 dark:hover:border-amber-500/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 w-[calc(50%-0.4rem)] sm:w-[calc(33.333%-0.6rem)] lg:w-auto lg:flex-1 min-w-[140px] sm:min-w-[155px] max-w-[200px] text-left">
        <div class="p-1.5 sm:p-2 rounded-lg sm:rounded-xl bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 flex-shrink-0">
          <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="min-w-0">
          <div class="text-xs sm:text-sm font-extrabold text-slate-900 dark:text-white truncate" data-i18n="badge_life_title">Lifetime</div>
          <div class="text-[10px] sm:text-[11px] text-slate-500 dark:text-slate-400 truncate" data-i18n="badge_life_sub">Akses Selamanya</div>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  /* Dynamic Ambient Aurora Orbs */
  .orb-1 {
    animation: floatOrb1 16s ease-in-out infinite alternate;
  }
  .orb-2 {
    animation: floatOrb2 20s ease-in-out infinite alternate;
  }
  .orb-3 {
    animation: pulseOrb3 12s ease-in-out infinite alternate;
  }
  .orb-4 {
    animation: floatOrb4 18s ease-in-out infinite alternate;
  }

  @keyframes floatOrb1 {
    0% { transform: translate3d(0, 0, 0) scale(1); }
    50% { transform: translate3d(45px, 35px, 0) scale(1.12); }
    100% { transform: translate3d(-35px, 50px, 0) scale(0.95); }
  }

  @keyframes floatOrb2 {
    0% { transform: translate3d(0, 0, 0) scale(1); }
    50% { transform: translate3d(-45px, 40px, 0) scale(1.1); }
    100% { transform: translate3d(30px, -30px, 0) scale(0.9); }
  }

  @keyframes pulseOrb3 {
    0%, 100% { transform: translate3d(-50%, 0, 0) scale(1); opacity: 0.18; }
    50% { transform: translate3d(-50%, -25px, 0) scale(1.22); opacity: 0.35; }
  }

  @keyframes floatOrb4 {
    0% { transform: translate3d(0, 0, 0) scale(0.9); }
    50% { transform: translate3d(35px, -20px, 0) scale(1.15); }
    100% { transform: translate3d(-20px, 15px, 0) scale(1); }
  }

  /* Floating Particles */
  .hero-particle {
    animation: particleFloat 6s ease-in-out infinite alternate;
  }
  .particle-1 { animation-duration: 5s; animation-delay: 0s; }
  .particle-2 { animation-duration: 7s; animation-delay: 1.2s; }
  .particle-3 { animation-duration: 6.5s; animation-delay: 2.5s; }
  .particle-4 { animation-duration: 8s; animation-delay: 0.8s; }
  .particle-5 { animation-duration: 5.5s; animation-delay: 3.1s; }
  .particle-6 { animation-duration: 7.2s; animation-delay: 1.8s; }

  @keyframes particleFloat {
    0% { transform: translateY(0px) scale(0.8); opacity: 0.2; }
    50% { opacity: 0.85; }
    100% { transform: translateY(-30px) scale(1.3); opacity: 0.3; }
  }

  /* Blinking Typewriter Cursor */
  #typewriter-cursor {
    animation: cursorBlink 0.85s step-start infinite;
  }
  @keyframes cursorBlink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
</style>

<script is:inline>
  (function () {
    const typewriterEl = document.getElementById('hero-typewriter');
    if (!typewriterEl) return;

    const phrases = {
      id: [
        '100% Gratis Selamanya',
        'Sertifikat Resmi Kelulusan',
        'Akses Seumur Hidup (Lifetime)',
        'Kupon Promo Legal Instruktur',
        'Update Kupon Setiap Hari'
      ],
      en: [
        '100% Free Forever',
        'Official Completion Certificate',
        'Lifetime Access Included',
        'Verified Instructor Promo',
        'Updated Daily With Fresh Coupons'
      ]
    };

    let wordIdx = 0;
    let charIdx = 0;
    let isDeleting = false;
    let timeoutId = null;

    function getActivePhrases() {
      const lang = document.documentElement.lang === 'en' ? 'en' : 'id';
      return phrases[lang] || phrases.id;
    }

    function typeTick() {
      const currentList = getActivePhrases();
      const currentWord = currentList[wordIdx % currentList.length];

      if (isDeleting) {
        charIdx--;
        typewriterEl.textContent = currentWord.substring(0, charIdx);

        if (charIdx <= 0) {
          isDeleting = false;
          wordIdx = (wordIdx + 1) % currentList.length;
          timeoutId = setTimeout(typeTick, 350);
          return;
        }
        timeoutId = setTimeout(typeTick, 45);
      } else {
        charIdx++;
        typewriterEl.textContent = currentWord.substring(0, charIdx);

        if (charIdx >= currentWord.length) {
          isDeleting = true;
          timeoutId = setTimeout(typeTick, 2400); // Jeda agar pengunjung sempat membaca
          return;
        }
        timeoutId = setTimeout(typeTick, 85);
      }
    }

    // Mulai animasi mengetik
    timeoutId = setTimeout(typeTick, 1200);

    // Respon saat pergantian bahasa di navbar
    window.addEventListener('languageChanged', () => {
      clearTimeout(timeoutId);
      charIdx = 0;
      isDeleting = false;
      typeTick();
    });
  })();
</script>
