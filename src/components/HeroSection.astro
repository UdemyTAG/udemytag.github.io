---
interface Props {
  totalCourses: number;
  totalActiveFree?: number;
  totalSubscribers?: number;
}

const { 
  totalCourses = 69, 
  totalActiveFree = 42, 
  totalSubscribers = 1450000 
} = Astro.props;

const subsFormatted = totalSubscribers >= 1000000 
  ? `${(totalSubscribers / 1000000).toFixed(1)}M+` 
  : `${Math.round(totalSubscribers / 1000)}k+`;
---

<section class="relative overflow-hidden pt-8 pb-10 sm:pt-14 sm:pb-16 bg-gradient-to-b from-slate-50/80 via-white to-transparent dark:from-slate-950 dark:via-slate-900/40 dark:to-slate-950 border-b border-slate-200/60 dark:border-slate-800/60">
  
  <!-- Dynamic Animated Ambient Background Layer (High Visibility) -->
  <div class="hero-bg-layer absolute inset-0 pointer-events-none overflow-hidden -z-10" aria-hidden="true">
    
    <!-- 1. Central Hero Glow Nebula (Directly behind Title & Subtitle) -->
    <div class="hero-nebula absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[340px] h-[240px] sm:w-[680px] sm:h-[400px] bg-gradient-to-r from-rose-600/40 via-purple-600/35 to-amber-500/35 dark:from-rose-600/60 dark:via-purple-600/50 dark:to-amber-500/45 rounded-full blur-2xl sm:blur-3xl animate-hero-nebula"></div>

    <!-- 2. Animated Pulse Rings (Concentric Tech Radar Aura) -->
    <div class="hero-pulse-ring"></div>
    <div class="hero-pulse-ring-2 hidden sm:block"></div>

    <!-- 3. Floating Glowing Ambient Aurora Orbs (Vivid & Rich) -->
    <div class="hero-orb orb-1 absolute -top-16 -left-16 w-80 h-80 sm:w-[32rem] sm:h-[32rem] bg-gradient-to-tr from-rose-600/40 via-pink-500/35 to-transparent dark:from-rose-500/60 dark:via-pink-600/50 dark:to-transparent rounded-full blur-2xl sm:blur-3xl"></div>
    <div class="hero-orb orb-2 absolute top-4 -right-16 w-80 h-80 sm:w-[30rem] sm:h-[30rem] bg-gradient-to-bl from-indigo-600/35 via-purple-600/30 to-transparent dark:from-indigo-500/55 dark:via-purple-600/50 dark:to-transparent rounded-full blur-2xl sm:blur-3xl"></div>
    <div class="hero-orb orb-3 absolute bottom-2 left-1/2 -translate-x-1/2 w-80 h-80 sm:w-[30rem] sm:h-[30rem] bg-gradient-to-r from-amber-500/30 via-rose-500/30 to-transparent dark:from-amber-400/50 dark:via-rose-500/45 dark:to-transparent rounded-full blur-2xl sm:blur-3xl"></div>
    <div class="hero-orb orb-4 absolute -bottom-16 left-1/4 w-72 h-72 sm:w-96 sm:h-96 bg-emerald-500/25 dark:bg-emerald-500/40 rounded-full blur-2xl sm:blur-3xl"></div>

    <!-- 4. Cyber Dot Matrix Grid (High Visibility with Radial Vignette Mask) -->
    <div class="hero-grid-pattern absolute inset-0 bg-[radial-gradient(#e11d48_1.5px,transparent_1.5px)] dark:bg-[radial-gradient(#f43f5e_1.5px,transparent_1.5px)] [background-size:24px_24px] opacity-25 dark:opacity-40 [mask-image:radial-gradient(ellipse_85%_75%_at_50%_45%,#000_30%,transparent_100%)]"></div>

    <!-- 5. Floating Glowing Sparkles / Star Particles (Vibrant & Distinct) -->
    <div class="hero-particle particle-1 absolute top-[18%] left-[12%]"></div>
    <div class="hero-particle particle-2 absolute top-[28%] right-[14%]"></div>
    <div class="hero-particle particle-3 absolute top-[45%] left-[22%]"></div>
    <div class="hero-particle particle-4 absolute top-[62%] right-[18%]"></div>
    <div class="hero-particle particle-5 absolute top-[15%] right-[28%]"></div>
    <div class="hero-particle particle-6 absolute bottom-[22%] left-[16%]"></div>
    <div class="hero-particle particle-7 absolute top-[38%] right-[32%]"></div>
    <div class="hero-particle particle-8 absolute top-[70%] left-[30%]"></div>
    <div class="hero-particle particle-9 absolute top-[22%] left-[38%]"></div>
    <div class="hero-particle particle-10 absolute bottom-[18%] right-[26%]"></div>
    <div class="hero-particle particle-11 absolute top-[52%] left-[8%]"></div>
    <div class="hero-particle particle-12 absolute top-[35%] right-[8%]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    
    <!-- Top Pill: Clean & 100% Real Verification -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-[11px] sm:text-xs font-semibold bg-white/90 dark:bg-slate-900/90 backdrop-blur-md border border-emerald-200/80 dark:border-emerald-900/50 shadow-sm text-emerald-700 dark:text-emerald-300 mb-4 sm:mb-6 transition-transform hover:scale-105">
      <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span class="font-extrabold text-emerald-700 dark:text-emerald-400">✓ <span>{totalActiveFree}</span> <span data-i18n="hero_pill_badge">Kupon Gratis</span></span>
      <span class="text-slate-300 dark:text-slate-700">|</span>
      <span class="font-bold" data-i18n="hero_pill">Terverifikasi Aktif Hari Ini</span>
    </div>

    <!-- Main Headline with Dynamic Typewriter Effect -->
    <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white max-w-4xl mx-auto leading-tight sm:leading-snug">
      <span data-i18n="hero_headline_lead">Kupon Diskon Kursus Udemy</span>
      <span class="block mt-1 sm:mt-2 text-transparent bg-clip-text bg-gradient-to-r from-rose-600 via-rose-500 to-amber-500 min-h-[1.3em]">
        <span id="hero-typewriter">100% Gratis Selamanya</span><span id="typewriter-cursor" class="inline-block text-rose-700 dark:text-rose-400 font-light ml-0.5 animate-pulse">|</span>
      </span>
    </h1>

    <!-- Subtitle / Value Proposition -->
    <p class="mt-3 sm:mt-4 text-xs sm:text-base text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed" data-i18n="hero_subtitle">
      Akses materi pembelajaran premium dari instruktur Udemy terkemuka. Lengkap dengan sertifikat kelulusan resmi dan hak akses seumur hidup tanpa biaya sepeser pun.
    </p>

    <!-- Key Highlights / Feature Badges: 100% RATA TENGAH (Centered) di Semua Layar -->
    <div class="mt-6 sm:mt-8 flex flex-wrap items-center justify-center gap-2.5 sm:gap-3.5 max-w-5xl mx-auto">
      
      <!-- 1. Total Siswa Belajar di Udemy (Data Riil Asli) -->
      <div class="flex items-center gap-2 sm:gap-2.5 p-2.5 sm:p-3 rounded-xl sm:rounded-2xl bg-white/90 dark:bg-slate-900/80 backdrop-blur-md border border-slate-200/80 dark:border-slate-800/80 shadow-sm hover:border-blue-400/50 dark:hover:border-blue-500/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 w-[calc(50%-0.4rem)] sm:w-[calc(33.333%-0.6rem)] lg:w-auto lg:flex-1 min-w-[140px] sm:min-w-[155px] max-w-[200px] text-left">
        <div class="p-1.5 sm:p-2 rounded-lg sm:rounded-xl bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex-shrink-0">
          <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </div>
        <div class="min-w-0">
          <div class="text-xs sm:text-sm font-extrabold text-slate-900 dark:text-white truncate">
            <span>{subsFormatted}</span>
          </div>
          <div class="text-[10px] sm:text-[11px] text-slate-600 dark:text-slate-300 font-medium truncate" data-i18n="badge_students_title">Siswa Belajar</div>
        </div>
      </div>

      <!-- 2. Kupon 100% Free Aktif Terverifikasi -->
      <div class="flex items-center gap-2 sm:gap-2.5 p-2.5 sm:p-3 rounded-xl sm:rounded-2xl bg-white/90 dark:bg-slate-900/80 backdrop-blur-md border border-slate-200/80 dark:border-slate-800/80 shadow-sm hover:border-emerald-400/50 dark:hover:border-emerald-500/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 w-[calc(50%-0.4rem)] sm:w-[calc(33.333%-0.6rem)] lg:w-auto lg:flex-1 min-w-[140px] sm:min-w-[155px] max-w-[200px] text-left">
        <div class="p-1.5 sm:p-2 rounded-lg sm:rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 flex-shrink-0">
          <svg class="w-4 h-4 sm:w-5 sm:h-5 fill-current animate-pulse" viewBox="0 0 24 24">
            <path d="M12 2c-.5 2.5-2.5 4.5-4 6-2 2-3 4.5-3 7 0 5 4 9 9 9s9-4 9-9c0-3.5-2-6-4.5-8-1-1-2-2.5-2.5-5-.5 1-1.5 2-4 2z"/>
          </svg>
        </div>
        <div class="min-w-0">
          <div class="text-xs sm:text-sm font-extrabold text-slate-900 dark:text-white truncate">{totalActiveFree} Kupon</div>
          <div class="text-[10px] sm:text-[11px] text-slate-600 dark:text-slate-300 font-medium truncate" data-i18n="badge_available">Aktif Hari Ini</div>
        </div>
      </div>

      <!-- 3. Total Kursus -->
      <div class="flex items-center gap-2 sm:gap-2.5 p-2.5 sm:p-3 rounded-xl sm:rounded-2xl bg-white/90 dark:bg-slate-900/80 backdrop-blur-md border border-slate-200/80 dark:border-slate-800/80 shadow-sm hover:border-rose-400/50 dark:hover:border-rose-500/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 w-[calc(50%-0.4rem)] sm:w-[calc(33.333%-0.6rem)] lg:w-auto lg:flex-1 min-w-[140px] sm:min-w-[155px] max-w-[200px] text-left">
        <div class="p-1.5 sm:p-2 rounded-lg sm:rounded-xl bg-rose-50 dark:bg-rose-950/60 text-rose-700 dark:text-rose-400 flex-shrink-0">
          <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        </div>
        <div class="min-w-0">
          <div class="text-xs sm:text-sm font-extrabold text-slate-900 dark:text-white truncate">{totalCourses}+ Kursus</div>
          <div class="text-[10px] sm:text-[11px] text-slate-600 dark:text-slate-300 font-medium truncate" data-i18n="badge_curated">Tersedia</div>
        </div>
      </div>

      <!-- 4. Legal Resmi -->
      <div class="flex items-center gap-2 sm:gap-2.5 p-2.5 sm:p-3 rounded-xl sm:rounded-2xl bg-white/90 dark:bg-slate-900/80 backdrop-blur-md border border-slate-200/80 dark:border-slate-800/80 shadow-sm hover:border-emerald-400/50 dark:hover:border-emerald-500/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 w-[calc(50%-0.4rem)] sm:w-[calc(33.333%-0.6rem)] lg:w-auto lg:flex-1 min-w-[140px] sm:min-w-[155px] max-w-[200px] text-left">
        <div class="p-1.5 sm:p-2 rounded-lg sm:rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 flex-shrink-0">
          <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="min-w-0">
          <div class="text-xs sm:text-sm font-extrabold text-slate-900 dark:text-white truncate" data-i18n="badge_legal_title">100% Legal</div>
          <div class="text-[10px] sm:text-[11px] text-slate-600 dark:text-slate-300 font-medium truncate" data-i18n="badge_legal_sub">Resmi Instruktur</div>
        </div>
      </div>

      <!-- 5. Sertifikat -->
      <div class="flex items-center gap-2 sm:gap-2.5 p-2.5 sm:p-3 rounded-xl sm:rounded-2xl bg-white/90 dark:bg-slate-900/80 backdrop-blur-md border border-slate-200/80 dark:border-slate-800/80 shadow-sm hover:border-blue-400/50 dark:hover:border-blue-500/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 w-[calc(50%-0.4rem)] sm:w-[calc(33.333%-0.6rem)] lg:w-auto lg:flex-1 min-w-[140px] sm:min-w-[155px] max-w-[200px] text-left">
        <div class="p-1.5 sm:p-2 rounded-lg sm:rounded-xl bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-400 flex-shrink-0">
          <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <div class="min-w-0">
          <div class="text-xs sm:text-sm font-extrabold text-slate-900 dark:text-white truncate" data-i18n="badge_cert_title">Sertifikat</div>
          <div class="text-[10px] sm:text-[11px] text-slate-600 dark:text-slate-300 font-medium truncate" data-i18n="badge_cert_sub">Kelulusan Resmi</div>
        </div>
      </div>

      <!-- 6. Lifetime -->
      <div class="flex items-center gap-2 sm:gap-2.5 p-2.5 sm:p-3 rounded-xl sm:rounded-2xl bg-white/90 dark:bg-slate-900/80 backdrop-blur-md border border-slate-200/80 dark:border-slate-800/80 shadow-sm hover:border-amber-400/50 dark:hover:border-amber-500/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 w-[calc(50%-0.4rem)] sm:w-[calc(33.333%-0.6rem)] lg:w-auto lg:flex-1 min-w-[140px] sm:min-w-[155px] max-w-[200px] text-left">
        <div class="p-1.5 sm:p-2 rounded-lg sm:rounded-xl bg-amber-50 dark:bg-amber-950/60 text-amber-700 dark:text-amber-400 flex-shrink-0">
          <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="min-w-0">
          <div class="text-xs sm:text-sm font-extrabold text-slate-900 dark:text-white truncate" data-i18n="badge_life_title">Lifetime</div>
          <div class="text-[10px] sm:text-[11px] text-slate-600 dark:text-slate-300 font-medium truncate" data-i18n="badge_life_sub">Akses Selamanya</div>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  /* Central Hero Nebula Glow */
  @keyframes nebulaPulse {
    0%, 100% {
      transform: translate3d(-50%, -50%, 0) scale(0.95);
      opacity: 0.8;
    }
    50% {
      transform: translate3d(-50%, -50%, 0) scale(1.15);
      opacity: 1;
    }
  }
  .animate-hero-nebula {
    animation: nebulaPulse 8s ease-in-out infinite;
  }

  /* Pulse Ring 1 (Concentric Radar Wave) */
  .hero-pulse-ring {
    position: absolute;
    top: 38%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 380px;
    height: 220px;
    border-radius: 50%;
    border: 1.5px solid rgba(244, 63, 94, 0.45);
    box-shadow: 0 0 30px rgba(244, 63, 94, 0.3), inset 0 0 20px rgba(244, 63, 94, 0.2);
    animation: ringPulse 4s ease-out infinite;
    pointer-events: none;
  }
  @media (min-width: 640px) {
    .hero-pulse-ring {
      width: 580px;
      height: 320px;
    }
  }

  @keyframes ringPulse {
    0% {
      transform: translate(-50%, -50%) scale(0.85);
      opacity: 0.85;
    }
    50% {
      opacity: 0.45;
    }
    100% {
      transform: translate(-50%, -50%) scale(1.3);
      opacity: 0;
    }
  }

  /* Pulse Ring 2 (Dashed Orbit) */
  .hero-pulse-ring-2 {
    position: absolute;
    top: 38%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 760px;
    height: 420px;
    border-radius: 50%;
    border: 1.5px dashed rgba(168, 85, 247, 0.35);
    animation: ringSpin 35s linear infinite;
    pointer-events: none;
  }

  @keyframes ringSpin {
    from { transform: translate(-50%, -50%) rotate(0deg); }
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }

  /* Floating Aurora Blobs */
  .orb-1 {
    animation: floatOrb1 14s ease-in-out infinite alternate;
  }
  .orb-2 {
    animation: floatOrb2 18s ease-in-out infinite alternate;
  }
  .orb-3 {
    animation: pulseOrb3 12s ease-in-out infinite alternate;
  }
  .orb-4 {
    animation: floatOrb4 16s ease-in-out infinite alternate;
  }

  @keyframes floatOrb1 {
    0% { transform: translate3d(0, 0, 0) scale(1); }
    50% { transform: translate3d(50px, 40px, 0) scale(1.18); }
    100% { transform: translate3d(-40px, 60px, 0) scale(0.92); }
  }

  @keyframes floatOrb2 {
    0% { transform: translate3d(0, 0, 0) scale(1); }
    50% { transform: translate3d(-50px, 45px, 0) scale(1.15); }
    100% { transform: translate3d(35px, -35px, 0) scale(0.88); }
  }

  @keyframes pulseOrb3 {
    0%, 100% { transform: translate3d(-50%, 0, 0) scale(1); opacity: 0.7; }
    50% { transform: translate3d(-50%, -30px, 0) scale(1.28); opacity: 1; }
  }

  @keyframes floatOrb4 {
    0% { transform: translate3d(0, 0, 0) scale(0.9); }
    50% { transform: translate3d(40px, -25px, 0) scale(1.2); }
    100% { transform: translate3d(-25px, 20px, 0) scale(1); }
  }

  /* Glowing Star Particles (Vibrant & Vivid) */
  .hero-particle {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    pointer-events: none;
  }
  .particle-1, .particle-4, .particle-9 {
    background: #f43f5e;
    box-shadow: 0 0 10px #f43f5e, 0 0 20px #f43f5e;
  }
  .particle-2, .particle-6, .particle-10 {
    background: #fbbf24;
    box-shadow: 0 0 10px #fbbf24, 0 0 20px #fbbf24;
  }
  .particle-3, .particle-7, .particle-12 {
    background: #c084fc;
    box-shadow: 0 0 10px #c084fc, 0 0 20px #c084fc;
  }
  .particle-5, .particle-8, .particle-11 {
    background: #34d399;
    box-shadow: 0 0 10px #34d399, 0 0 20px #34d399;
  }

  .particle-1 { animation: particleFloat 5s ease-in-out infinite alternate; animation-delay: 0s; }
  .particle-2 { animation: particleFloat 7s ease-in-out infinite alternate; animation-delay: 1.2s; width: 7px; height: 7px; }
  .particle-3 { animation: particleFloat 6.5s ease-in-out infinite alternate; animation-delay: 2.5s; }
  .particle-4 { animation: particleFloat 8s ease-in-out infinite alternate; animation-delay: 0.8s; width: 8px; height: 8px; }
  .particle-5 { animation: particleFloat 5.5s ease-in-out infinite alternate; animation-delay: 3.1s; }
  .particle-6 { animation: particleFloat 7.2s ease-in-out infinite alternate; animation-delay: 1.8s; }
  .particle-7 { animation: particleFloat 6s ease-in-out infinite alternate; animation-delay: 2.1s; width: 7px; height: 7px; }
  .particle-8 { animation: particleFloat 8.5s ease-in-out infinite alternate; animation-delay: 0.5s; }
  .particle-9 { animation: particleFloat 5.8s ease-in-out infinite alternate; animation-delay: 3.7s; }
  .particle-10 { animation: particleFloat 7.6s ease-in-out infinite alternate; animation-delay: 1.4s; }
  .particle-11 { animation: particleFloat 6.2s ease-in-out infinite alternate; animation-delay: 2.8s; }
  .particle-12 { animation: particleFloat 8.1s ease-in-out infinite alternate; animation-delay: 0.3s; }

  @keyframes particleFloat {
    0% { transform: translateY(0px) scale(0.85); opacity: 0.45; }
    50% { opacity: 1; transform: translateY(-18px) scale(1.25); }
    100% { transform: translateY(-38px) scale(0.9); opacity: 0.5; }
  }

  /* Blinking Typewriter Cursor */
  #typewriter-cursor {
    animation: cursorBlink 0.85s step-start infinite;
  }
  @keyframes cursorBlink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
</style>

<script is:inline>
  (function () {
    const typewriterEl = document.getElementById('hero-typewriter');
    if (!typewriterEl) return;

    const phrases = {
      id: [
        '100% Gratis Selamanya',
        'Sertifikat Resmi Kelulusan',
        'Akses Seumur Hidup (Lifetime)',
        'Kupon Promo Legal Instruktur',
        'Update Kupon Setiap Hari'
      ],
      en: [
        '100% Free Forever',
        'Official Completion Certificate',
        'Lifetime Access Included',
        'Verified Instructor Promo',
        'Updated Daily With Fresh Coupons'
      ]
    };

    let wordIdx = 0;
    let charIdx = 0;
    let isDeleting = false;
    let timeoutId = null;

    function getActivePhrases() {
      const lang = document.documentElement.lang === 'en' ? 'en' : 'id';
      return phrases[lang] || phrases.id;
    }

    function typeTick() {
      const currentList = getActivePhrases();
      const currentWord = currentList[wordIdx % currentList.length];

      if (isDeleting) {
        charIdx--;
        typewriterEl.textContent = currentWord.substring(0, charIdx);

        if (charIdx <= 0) {
          isDeleting = false;
          wordIdx = (wordIdx + 1) % currentList.length;
          timeoutId = setTimeout(typeTick, 350);
          return;
        }
        timeoutId = setTimeout(typeTick, 45);
      } else {
        charIdx++;
        typewriterEl.textContent = currentWord.substring(0, charIdx);

        if (charIdx >= currentWord.length) {
          isDeleting = true;
          timeoutId = setTimeout(typeTick, 2400); // Jeda agar pengunjung sempat membaca
          return;
        }
        timeoutId = setTimeout(typeTick, 85);
      }
    }

    // Mulai animasi mengetik
    timeoutId = setTimeout(typeTick, 1200);

    // Respon saat pergantian bahasa di navbar
    window.addEventListener('languageChanged', () => {
      clearTimeout(timeoutId);
      charIdx = 0;
      isDeleting = false;
      typeTick();
    });
  })();
</script>
