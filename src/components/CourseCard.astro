---
interface Course {
  id: string;
  title: string;
  url: string;
  image: string;
  category: string;
  coupon: string;
  instructor: string;
  originalPrice: string;
  discountPrice: string;
  rating: string;
  description: string;
  expiryDate: string;
}

interface Props {
  course: Course;
}

const { course } = Astro.props;

// Category badge color mapping
const categoryColors: Record<string, { bg: string; text: string; border: string }> = {
  'Development': { bg: 'bg-blue-50 dark:bg-blue-950/40', text: 'text-blue-700 dark:text-blue-300', border: 'border-blue-200 dark:border-blue-800/60' },
  'Business': { bg: 'bg-emerald-50 dark:bg-emerald-950/40', text: 'text-emerald-700 dark:text-emerald-300', border: 'border-emerald-200 dark:border-emerald-800/60' },
  'Design': { bg: 'bg-purple-50 dark:bg-purple-950/40', text: 'text-purple-700 dark:text-purple-300', border: 'border-purple-200 dark:border-purple-800/60' },
  'IT & Software': { bg: 'bg-amber-50 dark:bg-amber-950/40', text: 'text-amber-700 dark:text-amber-300', border: 'border-amber-200 dark:border-amber-800/60' },
  'Marketing': { bg: 'bg-rose-50 dark:bg-rose-950/40', text: 'text-rose-700 dark:text-rose-300', border: 'border-rose-200 dark:border-rose-800/60' },
  'Personal Development': { bg: 'bg-teal-50 dark:bg-teal-950/40', text: 'text-teal-700 dark:text-teal-300', border: 'border-teal-200 dark:border-teal-800/60' },
};

const catStyle = categoryColors[course.category] || {
  bg: 'bg-slate-100 dark:bg-slate-800',
  text: 'text-slate-700 dark:text-slate-300',
  border: 'border-slate-200 dark:border-slate-700'
};
---

<article 
  class="course-card group flex flex-col bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/90 dark:border-slate-800/90 overflow-hidden shadow-sm hover:shadow-xl hover:border-rose-500/40 dark:hover:border-rose-500/40 transition-all duration-300"
  data-id={course.id}
  data-title={course.title.toLowerCase()}
  data-category={course.category.toLowerCase()}
  data-instructor={course.instructor.toLowerCase()}
  data-rating={course.rating}
>
  <!-- Thumbnail & Badges Container -->
  <div class="relative aspect-video w-full overflow-hidden bg-slate-100 dark:bg-slate-800">
    <img
      src={course.image}
      alt={course.title}
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=600&auto=format&fit=crop&q=80';"
    />
    
    <!-- Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/20 pointer-events-none"></div>

    <!-- Discount Badge -->
    <div class="absolute top-3 left-3 flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-black bg-emerald-500 text-white shadow-lg shadow-emerald-500/30 tracking-wider uppercase">
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
      </svg>
      <span>100% OFF / FREE</span>
    </div>

    <!-- Category Pill Badge -->
    <div class="absolute top-3 right-3">
      <span class={`text-[11px] font-bold px-2.5 py-1 rounded-lg border backdrop-blur-md shadow-sm ${catStyle.bg} ${catStyle.text} ${catStyle.border}`}>
        {course.category}
      </span>
    </div>

    <!-- Rating & Price Floating Bar -->
    <div class="absolute bottom-2.5 left-3 right-3 flex items-center justify-between text-white text-xs font-semibold">
      <div class="flex items-center gap-1 bg-black/60 backdrop-blur-md px-2 py-0.5 rounded-md">
        <svg class="w-3.5 h-3.5 text-amber-400 fill-amber-400" viewBox="0 0 24 24">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
        </svg>
        <span class="font-bold">{course.rating}</span>
      </div>

      <div class="flex items-center gap-1.5 bg-black/60 backdrop-blur-md px-2 py-0.5 rounded-md">
        <span class="line-through text-slate-300 text-[11px]">{course.originalPrice}</span>
        <span class="text-emerald-400 font-extrabold uppercase">GRATIS</span>
      </div>
    </div>
  </div>

  <!-- Course Body Content -->
  <div class="flex flex-col flex-1 p-5">
    
    <!-- Title -->
    <h3 class="font-bold text-slate-900 dark:text-white text-base leading-snug line-clamp-2 min-h-[2.75rem] group-hover:text-rose-600 dark:group-hover:text-rose-400 transition-colors" title={course.title}>
      {course.title}
    </h3>

    <!-- Description -->
    <p class="mt-2 text-xs text-slate-600 dark:text-slate-400 line-clamp-2 leading-relaxed">
      {course.description}
    </p>

    <!-- Meta Details: Instructor & Expiry -->
    <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400">
      <div class="flex items-center gap-1.5 truncate max-w-[150px]">
        <svg class="w-3.5 h-3.5 text-slate-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        <span class="truncate">{course.instructor}</span>
      </div>

      <div class="flex items-center gap-1 text-[10px] text-slate-400 dark:text-slate-500">
        <svg class="w-3 h-3 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <circle cx="12" cy="12" r="10" stroke-width="2"/>
          <polyline points="12 6 12 12 16 14" stroke-width="2"/>
        </svg>
        <span class="truncate">{course.expiryDate}</span>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="mt-4 grid grid-cols-2 gap-2 pt-2">
      <!-- Copy Coupon Button -->
      <button
        type="button"
        class="copy-coupon-btn inline-flex items-center justify-center gap-1.5 px-3 py-2.5 rounded-xl text-xs font-bold border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/80 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700/80 hover:text-rose-600 dark:hover:text-rose-400 transition-all focus:outline-none focus:ring-2 focus:ring-rose-500"
        data-coupon={course.coupon}
        aria-label={`Salin kupon untuk kursus ${course.title}`}
      >
        <svg class="copy-icon w-3.5 h-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2" stroke-width="2"/>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" stroke-width="2"/>
        </svg>
        <svg class="check-icon hidden w-3.5 h-3.5 text-emerald-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
        </svg>
        <span class="btn-text truncate">Salin Kupon</span>
      </button>

      <!-- Open in Udemy CTA -->
      <a
        href={course.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-1.5 px-3 py-2.5 rounded-xl text-xs font-bold bg-slate-900 hover:bg-rose-600 dark:bg-rose-600 dark:hover:bg-rose-500 text-white shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-rose-500"
        aria-label={`Buka kursus ${course.title} di Udemy`}
      >
        <span class="truncate">Buka di Udemy</span>
        <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>

  </div>
</article>
