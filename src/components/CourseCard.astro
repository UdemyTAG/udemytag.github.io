---
interface Course {
  id: string;
  slug?: string;
  title: string;
  url: string;
  image: string;
  category: string;
  coupon: string;
  instructor: string;
  originalPrice: string;
  discountPrice: string;
  rating: string;
  claimedCount?: number;
  quota?: number;
  description: string;
  expiryDate: string;
}

interface Props {
  course: Course;
}

const { course } = Astro.props;

// Category badge color mapping
const categoryColors: Record<string, { bg: string; text: string; border: string }> = {
  'Development': { bg: 'bg-blue-50 dark:bg-blue-950/60', text: 'text-blue-700 dark:text-blue-300', border: 'border-blue-200 dark:border-blue-800/60' },
  'Business': { bg: 'bg-emerald-50 dark:bg-emerald-950/60', text: 'text-emerald-700 dark:text-emerald-300', border: 'border-emerald-200 dark:border-emerald-800/60' },
  'Design': { bg: 'bg-purple-50 dark:bg-purple-950/60', text: 'text-purple-700 dark:text-purple-300', border: 'border-purple-200 dark:border-purple-800/60' },
  'IT & Software': { bg: 'bg-amber-50 dark:bg-amber-950/60', text: 'text-amber-700 dark:text-amber-300', border: 'border-amber-200 dark:border-amber-800/60' },
  'Marketing': { bg: 'bg-rose-50 dark:bg-rose-950/60', text: 'text-rose-700 dark:text-rose-300', border: 'border-rose-200 dark:border-rose-800/60' },
  'Personal Development': { bg: 'bg-teal-50 dark:bg-teal-950/60', text: 'text-teal-700 dark:text-teal-300', border: 'border-teal-200 dark:border-teal-800/60' },
};

const catStyle = categoryColors[course.category] || {
  bg: 'bg-slate-100 dark:bg-slate-800',
  text: 'text-slate-700 dark:text-slate-300',
  border: 'border-slate-200 dark:border-slate-700'
};

const courseSlug = course.slug || course.id;
const dedicatedCourseUrl = `https://udemytag.github.io/course/${courseSlug}/`;

// Format tanggal bersih tanpa detik jam agar tidak memotong nama instruktur
const cleanDate = course.expiryDate ? course.expiryDate.split(' ')[0] : 'Aktif';

// Angka kupon terklaim dan kuota kupon
const claimed = course.claimedCount || 420;
const quota = course.quota || 500;
const remainingSlots = Math.max(0, quota - claimed);
const claimPercent = Math.min(100, Math.round((claimed / quota) * 100));
---

<article 
  class="course-card group flex flex-col bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/90 dark:border-slate-800/90 overflow-hidden shadow-sm hover:shadow-xl hover:border-rose-500/40 dark:hover:border-rose-500/40 transition-all duration-300"
  data-id={course.id}
  data-slug={courseSlug}
  data-title={course.title.toLowerCase()}
  data-category={course.category.toLowerCase()}
  data-instructor={course.instructor.toLowerCase()}
  data-rating={course.rating}
  data-claimed={claimed}
  id={course.id}
>
  <!-- Thumbnail Media Container (Bersih tanpa tumpukan badge ganda) -->
  <a href={`/course/${courseSlug}/`} class="relative aspect-video w-full overflow-hidden bg-slate-100 dark:bg-slate-800 block">
    <img
      src={course.image}
      alt={course.title}
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=600&auto=format&fit=crop&q=80';"
    />
    
    <!-- Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-transparent to-black/25 pointer-events-none"></div>

    <!-- 100% OFF Badge (Hanya badge ini di atas thumbnail agar rapi dan tidak bertabrakan) -->
    <div class="absolute top-2.5 left-2.5 flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-black bg-emerald-500 text-white shadow-md shadow-emerald-500/40 tracking-wider uppercase">
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
      </svg>
      <span>100% OFF</span>
    </div>

    <!-- Rating & Price Floating Bar -->
    <div class="absolute bottom-2 left-2.5 right-2.5 flex items-center justify-between text-white text-[11px] sm:text-xs font-semibold">
      <div class="flex items-center gap-1 bg-black/75 backdrop-blur-md px-2 py-0.5 rounded-md">
        <svg class="w-3.5 h-3.5 text-amber-400 fill-amber-400" viewBox="0 0 24 24">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
        </svg>
        <span class="font-bold">{course.rating}</span>
      </div>

      <div class="flex items-center gap-1.5 bg-black/75 backdrop-blur-md px-2 py-0.5 rounded-md">
        <span class="line-through text-slate-300 text-[10px]">{course.originalPrice}</span>
        <span class="free-badge-label text-emerald-400 font-extrabold uppercase">GRATIS</span>
      </div>
    </div>
  </a>

  <!-- Course Body Content -->
  <div class="flex flex-col flex-1 p-3.5 sm:p-4">
    
    <!-- Category Tag & Live Status Row -->
    <div class="flex items-center justify-between gap-2 mb-2">
      <span class={`text-[10px] font-bold px-2 py-0.5 rounded-md border ${catStyle.bg} ${catStyle.text} ${catStyle.border}`}>
        {course.category}
      </span>
      <span class="inline-flex items-center gap-1 text-[10px] font-semibold text-emerald-600 dark:text-emerald-400">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="coupon-status-text">Kupon Aktif</span>
      </span>
    </div>

    <!-- Title -->
    <h3 class="font-bold text-slate-900 dark:text-white text-sm sm:text-base leading-snug line-clamp-2 min-h-[2.5rem] group-hover:text-rose-600 dark:group-hover:text-rose-400 transition-colors" title={course.title}>
      <a href={`/course/${courseSlug}/`}>
        {course.title}
      </a>
    </h3>

    <!-- Description -->
    <p class="mt-1.5 text-xs text-slate-600 dark:text-slate-400 line-clamp-2 leading-relaxed">
      {course.description}
    </p>

    <!-- Meta Details: Instructor & Expiry (Luas tanpa terpotong) -->
    <div class="mt-3 pt-2.5 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400 gap-2">
      <div class="flex items-center gap-1.5 min-w-0 flex-1" title={course.instructor}>
        <svg class="w-3.5 h-3.5 text-slate-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        <span class="truncate font-medium text-slate-700 dark:text-slate-300">{course.instructor}</span>
      </div>

      <div class="flex items-center gap-1 text-[10px] text-slate-400 dark:text-slate-500 flex-shrink-0">
        <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2" stroke-width="2"/>
          <line x1="16" y1="2" x2="16" y2="6" stroke-width="2"/>
          <line x1="8" y1="2" x2="8" y2="6" stroke-width="2"/>
          <line x1="3" y1="10" x2="21" y2="10" stroke-width="2"/>
        </svg>
        <span>{cleanDate}</span>
      </div>
    </div>

    <!-- Live Coupon Claims & Quota Progress Indicator -->
    <div class="mt-2.5 pt-2 border-t border-slate-100 dark:border-slate-800/80">
      <div class="flex items-center justify-between text-[11px] mb-1">
        <span class="flex items-center gap-1 font-bold text-rose-600 dark:text-rose-400">
          <svg class="w-3.5 h-3.5 fill-current text-rose-500 flex-shrink-0 animate-pulse" viewBox="0 0 24 24">
            <path d="M12 2c-.5 2.5-2.5 4.5-4 6-2 2-3 4.5-3 7 0 5 4 9 9 9s9-4 9-9c0-3.5-2-6-4.5-8-1-1-2-2.5-2.5-5-.5 1-1.5 2-4 2z"/>
          </svg>
          <span class="card-claimed-number font-extrabold" data-course-id={course.id} data-base={claimed}>{claimed}</span>
          <span class="card-claim-label" data-i18n="claim_unit">Klaim</span>
        </span>

        <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium">
          <span data-i18n="quota_prefix">Sisa</span> <span class="card-remaining-number font-bold text-slate-700 dark:text-slate-300" data-course-id={course.id}>{remainingSlots}</span> <span data-i18n="quota_suffix">Slot</span>
        </span>
      </div>

      <!-- Mini Progress Bar -->
      <div class="w-full h-1.5 bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
        <div 
          class="card-claim-bar h-full bg-gradient-to-r from-rose-500 via-rose-600 to-amber-500 rounded-full transition-all duration-500" 
          data-course-id={course.id}
          data-quota={quota}
          style={`width: ${claimPercent}%`}
        ></div>
      </div>
    </div>

    <!-- Action Buttons Toolbar (Terstruktur Rapi: Tombol Utama Full Width + 2 Tombol Utilitas Simetris) -->
    <div class="mt-3 pt-2.5 border-t border-slate-100 dark:border-slate-800 space-y-2">
      
      <!-- 1. Direct CTA to Udemy (Lebar Penuh & Teks Tidak Terpotong) -->
      <a
        href={course.url}
        target="_blank"
        rel="noopener noreferrer"
        class="claim-action-trigger w-full inline-flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-xl text-xs font-extrabold bg-gradient-to-r from-rose-600 to-rose-700 hover:from-rose-500 hover:to-rose-600 text-white shadow-md shadow-rose-600/25 active:scale-[0.98] transition-all text-center"
        data-course-id={course.id}
        aria-label={`Buka kursus ${course.title} di Udemy`}
      >
        <span class="open-btn-text">Buka di Udemy</span>
        <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>

      <!-- 2. Utility Actions: Salin Kupon (50%) & Salin Link (50%) -->
      <div class="grid grid-cols-2 gap-2">
        
        <!-- Salin Kupon -->
        <button
          type="button"
          class="copy-coupon-btn claim-action-trigger inline-flex items-center justify-center gap-1 px-2.5 py-2 rounded-xl text-xs font-bold border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700/80 hover:text-rose-600 dark:hover:text-rose-400 active:scale-95 transition-all"
          data-coupon={course.coupon}
          data-course-id={course.id}
          aria-label={`Salin kupon untuk ${course.title}`}
        >
          <svg class="copy-icon w-3.5 h-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2" stroke-width="2"/>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" stroke-width="2"/>
          </svg>
          <svg class="check-icon hidden w-3.5 h-3.5 text-emerald-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
          </svg>
          <span class="btn-text copy-btn-text truncate">Salin Kupon</span>
        </button>

        <!-- Salin Link (Tanpa Toast Popup) -->
        <button
          type="button"
          class="copy-post-link-btn inline-flex items-center justify-center gap-1 px-2.5 py-2 rounded-xl text-xs font-bold border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700/80 hover:text-blue-600 dark:hover:text-blue-400 active:scale-95 transition-all"
          data-link={dedicatedCourseUrl}
          data-course-id={course.id}
          title="Salin Link"
          aria-label="Salin Link"
        >
          <svg class="link-icon w-3.5 h-3.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 7.07 7.07l1.71-1.71"/>
          </svg>
          <svg class="link-check-icon hidden w-3.5 h-3.5 text-emerald-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
          </svg>
          <span class="link-btn-text copy-link-text truncate">Salin Link</span>
        </button>

      </div>

    </div>

  </div>
</article>
