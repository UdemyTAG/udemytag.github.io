---
import ArticleCard from './ArticleCard.astro';
import articlesData from '../data/articles.json';

interface Props {
  maxItems?: number;
}

const { maxItems = 3 } = Astro.props;

// Sort articles: featured first, then newest
const sortedArticles = [...articlesData].sort((a, b) => {
  if (a.featured && !b.featured) return -1;
  if (!a.featured && b.featured) return 1;
  return new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime();
});

const displayArticles = sortedArticles.slice(0, maxItems);
---

<section id="tutorial" class="border-t border-slate-200/80 dark:border-slate-800 bg-white/60 dark:bg-slate-900/40 py-10 sm:py-16 transition-colors">
  <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8 sm:mb-10">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-rose-100 dark:bg-rose-950/70 text-rose-700 dark:text-rose-300 border border-rose-200 dark:border-rose-800/80 mb-2">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
          </svg>
          <span data-i18n="tutorial_badge">Tutorial & Tips Singkat</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight" data-i18n="tutorial_section_title">
          Tingkatkan Skill Digital & Maksimalkan Belajar
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-1.5 leading-relaxed" data-i18n="tutorial_section_desc">
          Kumpulan panduan teknis, tips pemrograman, pemanfaatan AI, keamanan siber, dan strategi klaim sertifikat resmi Udemy secara gratis seumur hidup.
        </p>
      </div>

      <a
        href="/tutorial/"
        class="inline-flex items-center gap-2 self-start md:self-auto px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold bg-slate-900 hover:bg-rose-600 dark:bg-slate-800 dark:hover:bg-rose-600 text-white transition-all shadow-sm group flex-shrink-0"
      >
        <span class="tutorial-view-all-text" data-i18n="tutorial_view_all_btn">Lihat Semua ({articlesData.length} Tutorial)</span>
        <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- Articles Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
      {displayArticles.map((article) => (
        <ArticleCard article={article} />
      ))}
    </div>

    <!-- Quick Topic Badges for SEO Signals -->
    <div class="mt-8 pt-6 border-t border-slate-200/80 dark:border-slate-800 flex flex-wrap items-center justify-between gap-3 text-xs text-slate-500 dark:text-slate-400">
      <div class="flex items-center gap-2 font-medium">
        <span class="font-bold text-slate-700 dark:text-slate-300" data-i18n="tutorial_popular_topics">Topik Populer:</span>
        <div class="flex flex-wrap gap-1.5">
          <a href="/tutorial/?cat=Edukasi+%26+Karir" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-rose-50 dark:hover:bg-rose-950/40 hover:text-rose-600 dark:hover:text-rose-400 transition-colors">#KuponUdemy</a>
          <a href="/tutorial/?cat=Programming+%26+IT" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-rose-50 dark:hover:bg-rose-950/40 hover:text-rose-600 dark:hover:text-rose-400 transition-colors">#WebDev</a>
          <a href="/tutorial/?cat=Data+Science+%26+AI" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-rose-50 dark:hover:bg-rose-950/40 hover:text-rose-600 dark:hover:text-rose-400 transition-colors">#PythonAI</a>
          <a href="/tutorial/?cat=Cyber+Security+%26+IT" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-rose-50 dark:hover:bg-rose-950/40 hover:text-rose-600 dark:hover:text-rose-400 transition-colors">#CyberSecurity</a>
          <a href="/tutorial/?cat=Desain+%26+UI%2FUX" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-rose-50 dark:hover:bg-rose-950/40 hover:text-rose-600 dark:hover:text-rose-400 transition-colors">#UIUXDesign</a>
        </div>
      </div>

      <a href="/tutorial/" class="font-bold text-rose-600 dark:text-rose-400 hover:underline inline-flex items-center gap-1">
        <span data-i18n="tutorial_archive_link">Arsip Tutorial Lengkap →</span>
      </a>
    </div>

  </div>
</section>
