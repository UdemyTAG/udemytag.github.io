---
interface Props {
  article: {
    id: string;
    slug: string;
    title: string;
    excerpt: string;
    category: string;
    readTime: number;
    author: string;
    publishedAt: string;
    image?: string;
    featured?: boolean;
    seoKeywords?: string[];
  };
}

const { article } = Astro.props;

// Category Badge Color Palette
const categoryColors: Record<string, string> = {
  'Edukasi & Karir': 'bg-amber-100 text-amber-800 dark:bg-amber-950/70 dark:text-amber-300 border-amber-300 dark:border-amber-700/60',
  'Programming & IT': 'bg-indigo-100 text-indigo-800 dark:bg-indigo-950/70 dark:text-indigo-300 border-indigo-300 dark:border-indigo-700/60',
  'Data Science & AI': 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/70 dark:text-emerald-300 border-emerald-300 dark:border-emerald-700/60',
  'Cyber Security & IT': 'bg-rose-100 text-rose-800 dark:bg-rose-950/70 dark:text-rose-300 border-rose-300 dark:border-rose-700/60',
  'Desain & UI/UX': 'bg-fuchsia-100 text-fuchsia-800 dark:bg-fuchsia-950/70 dark:text-fuchsia-300 border-fuchsia-300 dark:border-fuchsia-700/60',
};

const badgeClass = categoryColors[article.category] || 'bg-slate-100 text-slate-800 dark:bg-slate-800 dark:text-slate-300 border-slate-300 dark:border-slate-700';
---

<article class="group relative flex flex-col justify-between rounded-2xl border border-slate-200 dark:border-slate-800/80 bg-white dark:bg-slate-900/90 overflow-hidden shadow-sm hover:shadow-xl hover:border-rose-400 dark:hover:border-rose-500/50 transition-all duration-300 transform hover:-translate-y-1">
  
  <!-- Cover Image Thumbnail -->
  {article.image && (
    <a href={`/tutorial/${article.slug}/`} class="block relative aspect-[16/9] w-full overflow-hidden bg-slate-100 dark:bg-slate-800">
      <img
        src={article.image}
        alt={article.title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
        decoding="async"
        width="600"
        height="338"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
      
      <!-- Category Badge Floating over image -->
      <div class="absolute top-3 left-3">
        <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full font-bold border text-[10px] shadow-sm backdrop-blur-md ${badgeClass}`}>
          {article.category}
        </span>
      </div>
    </a>
  )}

  <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between">
    <div class="space-y-3">
      <!-- Meta: Read Time + Date (if no image, also show category badge) -->
      <div class="flex items-center justify-between gap-2 text-xs">
        {!article.image && (
          <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full font-bold border text-[11px] ${badgeClass}`}>
            {article.category}
          </span>
        )}
        <span class="inline-flex items-center gap-1 text-slate-500 dark:text-slate-400 text-[11px] font-medium font-mono">
          <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
          <span>{article.readTime} mnt baca</span>
        </span>
        <span class="text-slate-400 text-[11px]">{article.publishedAt}</span>
      </div>

      <!-- Title -->
      <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white group-hover:text-rose-600 dark:group-hover:text-rose-400 transition-colors leading-snug line-clamp-2">
        <a href={`/tutorial/${article.slug}/`} class="focus:outline-none focus:ring-2 focus:ring-rose-500 rounded-lg">
          {article.title}
        </a>
      </h3>

      <!-- Excerpt -->
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed line-clamp-2">
        {article.excerpt}
      </p>
    </div>

    <!-- Footer Action Link -->
    <div class="pt-4 mt-4 border-t border-slate-100 dark:border-slate-800/60 flex items-center justify-between text-xs">
      <span class="text-[11px] font-medium text-slate-500 dark:text-slate-400">{article.author}</span>
      
      <a 
        href={`/tutorial/${article.slug}/`} 
        class="inline-flex items-center gap-1 font-bold text-rose-600 dark:text-rose-400 hover:text-rose-700 dark:hover:text-rose-300 transition-colors group-hover:translate-x-0.5 transform transition-transform"
      >
        <span>Baca Tutorial</span>
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>

</article>
