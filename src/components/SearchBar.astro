---
interface Props {
  totalCount: number;
}

const { totalCount = 80 } = Astro.props;
---

<div class="w-full flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
  <!-- Search Input Container -->
  <div class="relative flex-1 group">
    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400 group-focus-within:text-rose-600 transition-colors">
      <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </div>

    <label for="search-input" class="sr-only">Cari kursus Udemy gratis</label>
    <input
      id="search-input"
      type="text"
      name="search"
      aria-label="Cari kursus Udemy gratis"
      placeholder="Cari kursus (cth: Python, Figma, Excel)..."
      data-placeholder-id="Cari kursus (cth: Python, Figma, Excel)..."
      data-placeholder-en="Search courses (e.g. Python, Figma, Excel)..."
      class="w-full pl-9 sm:pl-10 pr-20 py-2.5 sm:py-3 rounded-xl sm:rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-rose-500 transition-all shadow-sm"
      autocomplete="off"
    />

    <!-- Clear Search Button & Shortcut Badge -->
    <div class="absolute inset-y-0 right-0 pr-2.5 flex items-center gap-1">
      <button
        id="clear-search-btn"
        type="button"
        class="hidden p-1 rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
        aria-label="Bersihkan pencarian"
      >
        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <span class="hidden sm:inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-mono text-slate-400 dark:text-slate-500 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700">
        /
      </span>
    </div>
  </div>

  <!-- Sort Dropdown & Quick Counter -->
  <div class="flex items-center justify-between sm:justify-end gap-2 flex-shrink-0">
    <div class="flex items-center gap-1.5">
      <label for="sort-select" class="text-[11px] sm:text-xs font-semibold text-slate-500 dark:text-slate-400 flex items-center gap-1 cursor-pointer">
        <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h13M3 8h9m-9 4h6m4 0l4-4m0 0l4 4m-4-4v12" />
        </svg>
        <span class="sr-only">Urutkan Kursus</span>
        <span class="hidden sm:inline" data-i18n="sort_label">Urutkan:</span>
      </label>
      <select
        id="sort-select"
        name="sort"
        aria-label="Urutkan Kursus"
        class="px-2.5 py-2 sm:px-3 sm:py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 text-[11px] sm:text-xs font-medium focus:outline-none focus:ring-2 focus:ring-rose-500 cursor-pointer shadow-sm"
      >
        <option value="default" data-i18n="sort_default">Terbaru</option>
        <option value="rating-desc" data-i18n="sort_rating">Rating Tertinggi</option>
        <option value="title-asc" data-i18n="sort_title">Judul (A - Z)</option>
      </select>
    </div>

    <!-- Active Count Counter -->
    <div class="px-2.5 py-1.5 sm:px-3 sm:py-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-[11px] sm:text-xs font-semibold">
      <span id="filtered-count">{totalCount}</span> <span data-i18n="count_courses_label">Kursus</span>
    </div>
  </div>
</div>
