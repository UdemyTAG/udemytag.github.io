---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  courses?: any[];
  loadGlobalI18n?: boolean;
}

const {
  title = 'UdemyTAG - Kupon Diskon 100% & Kursus Gratis Udemy Bersertifikat Terbaru 2026',
  description = 'Koleksi kupon diskon 100% dan kursus Udemy gratis bersertifikat resmi terbaru 2026. Klaim akses seumur hidup untuk Web Development, Python, Desain, Bisnis & IT!',
  image = 'https://udemytag.github.io/og-image.png',
  canonical,
  courses = [],
  loadGlobalI18n = true
} = Astro.props;

const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site || 'https://udemytag.github.io').toString();

// Schema.org JSON-LD (Search Engines & Generative AI Optimization)
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': 'UdemyTAG',
  'alternateName': 'Trik Android Gold - Kupon Kursus Udemy Gratis Bersertifikat',
  'url': 'https://udemytag.github.io/',
  'description': 'Direktori kurasi kupon diskon 100% dan kursus gratis Udemy resmi bersertifikat.',
  'inLanguage': 'id-ID',
  'potentialAction': {
    '@type': 'SearchAction',
    'target': 'https://udemytag.github.io/?q={search_term_string}#katalog',
    'query-input': 'required name=search_term_string'
  }
};

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  'name': 'UdemyTAG',
  'url': 'https://udemytag.github.io/',
  'logo': 'https://udemytag.github.io/logo-512.png',
  'sameAs': [
    'https://t.me/trikandroidgold',
    'https://web.facebook.com/Trikandroidgold'
  ]
};

const pageSchemas: any[] = [websiteSchema, orgSchema];

if (courses.length === 1) {
  const c = courses[0];
  const courseSchema = {
    '@context': 'https://schema.org',
    '@type': 'Course',
    'name': c.title,
    'description': c.description || description,
    'image': c.image || image,
    'provider': {
      '@type': 'Organization',
      'name': 'Udemy',
      'sameAs': 'https://www.udemy.com'
    },
    'instructor': {
      '@type': 'Person',
      'name': c.instructor || 'Udemy Instructor'
    },
    'offers': {
      '@type': 'Offer',
      'price': '0',
      'priceCurrency': 'USD',
      'category': 'Free Coupon',
      'url': c.url,
      'availability': 'https://schema.org/InStock',
      'validFrom': '2026-01-01'
    },
    'aggregateRating': {
      '@type': 'AggregateRating',
      'ratingValue': (c.rating || 4.8).toString(),
      'reviewCount': (c.reviews || 120).toString(),
      'bestRating': '5'
    }
  };

  const breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    'itemListElement': [
      {
        '@type': 'ListItem',
        'position': 1,
        'name': 'Beranda',
        'item': 'https://udemytag.github.io/'
      },
      {
        '@type': 'ListItem',
        'position': 2,
        'name': c.category || 'Courses',
        'item': `https://udemytag.github.io/?cat=${(c.category || 'all').toLowerCase()}#katalog`
      },
      {
        '@type': 'ListItem',
        'position': 3,
        'name': c.title,
        'item': canonicalURL
      }
    ]
  };

  pageSchemas.push(courseSchema, breadcrumbSchema);
} else if (courses.length > 1) {
  const itemListSchema = {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    'name': 'Koleksi Kupon Kursus Udemy 100% Gratis - UdemyTAG',
    'description': description,
    'numberOfItems': courses.length,
    'itemListElement': courses.slice(0, 10).map((course, index) => ({
      '@type': 'ListItem',
      'position': index + 1,
      'item': {
        '@type': 'Course',
        'name': course.title,
        'description': course.description,
        'image': course.image,
        'provider': {
          '@type': 'Organization',
          'name': 'Udemy',
          'sameAs': 'https://www.udemy.com'
        },
        'instructor': {
          '@type': 'Person',
          'name': course.instructor || 'Udemy Instructor'
        },
        'offers': {
          '@type': 'Offer',
          'price': '0',
          'priceCurrency': 'USD',
          'category': 'Free',
          'url': course.url,
          'availability': 'https://schema.org/InStock'
        }
      }
    }))
  };

  const faqSchema = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    'mainEntity': [
      {
        '@type': 'Question',
        'name': 'Bagaimana cara klaim kursus agar harganya menjadi Rp0?',
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': 'Klik tombol "Buka di Udemy" pada kartu kursus. Tautan tersebut sudah secara otomatis menyematkan kode kupon diskon 100%. Pastikan harga yang tertera di halaman kursus Udemy adalah Free / Gratis (Rp0) sebelum menekan tombol "Daftar Sekarang" (Enroll Now).'
        }
      },
      {
        '@type': 'Question',
        'name': 'Mengapa saat saya buka, harganya kembali berbayar?',
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': 'Kupon diskon 100% yang diterbitkan oleh instruktur Udemy memiliki batas kuota maksimal (biasanya 500 hingga 1.000 klaim di seluruh dunia) atau batas waktu tertentu (1 - 3 hari). Jika kuota klaim telah habis, Udemy otomatis mengembalikan harga ke nominal semula. Selalu klaim secepatnya saat kursus baru muncul di UdemyTAG.'
        }
      },
      {
        '@type': 'Question',
        'name': 'Apakah kursus yang diklaim gratis tetap mendapatkan Sertifikat Resmi?',
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': 'Ya, 100% resmi! Karena Anda mendaftar menggunakan kupon diskon resmi dari pembuat kursus, Anda terdaftar sebagai siswa resmi dan berhak mendapatkan sertifikat kelulusan digital (Certificate of Completion) setelah menyelesaikan seluruh materi.'
        }
      },
      {
        '@type': 'Question',
        'name': 'Apakah akses materi kursus berlaku seumur hidup?',
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': 'Ya, setelah berhasil menambahkan kursus ke akun Udemy Anda, kursus tersebut akan tersimpan permanen di menu "My Learning" dan dapat diakses kapan saja tanpa batas waktu kedaluwarsa.'
        }
      },
      {
        '@type': 'Question',
        'name': 'Di mana saya bisa mendapatkan pemberitahuan kupon rilis paling cepat?',
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': 'Anda dapat bergabung di Channel Telegram kami di @trikandroidgold (https://t.me/trikandroidgold) dan mengikuti halaman Facebook kami di @Trikandroidgold (https://web.facebook.com/Trikandroidgold) untuk mendapatkan info kupon gratis seketika begitu dirilis.'
        }
      }
    ]
  };

  pageSchemas.push(itemListSchema, faqSchema);
}
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="192x192" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="kupon udemy gratis, kursus gratis udemy, udemy coupon 100% off, kursus online bersertifikat, kursus python gratis, web development gratis, sertifikat udemy gratis, kupon diskon udemy, belajar coding gratis, udemytag" />
    <meta name="author" content="UdemyTAG" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Google Search Console Verification -->
    <meta name="google-site-verification" content="googleb222826079f07436.html" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="UdemyTAG" />
    <meta property="og:locale" content="id_ID" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Third-party Resource Preconnect & DNS-Prefetch (Reduces Network Handshake Latency) -->
    <link rel="dns-prefetch" href="https://img-c.udemycdn.com" />
    <link rel="preconnect" href="https://img-c.udemycdn.com" crossorigin />

    <!-- Schema.org JSON-LD (Search Engines & Generative AI Optimization) -->
    {pageSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Dark Mode Init Script (no-FOUC) -->
    <script is:inline>
      try {
        if (
          localStorage.getItem('theme') === 'dark' ||
          (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)
        ) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      } catch (_) {}
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 transition-colors duration-200">
    <slot />

    <!-- Toast Notification Container -->
    <div id="toast-container" class="fixed bottom-6 right-6 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <script is:inline>
      // Global toast helper
      window.showToast = function(message, type = 'success') {
        const container = document.getElementById('toast-container');
        if (!container) return;

        const toast = document.createElement('div');
        toast.className = `pointer-events-auto flex items-center gap-2 px-4 py-3 rounded-xl shadow-xl text-sm font-medium transition-all duration-300 transform translate-y-4 opacity-0 ${
          type === 'success' 
            ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900 border border-slate-700/30' 
            : 'bg-rose-700 text-white'
        }`;
        
        toast.innerHTML = `
          <svg class="w-4 h-4 text-emerald-400 dark:text-emerald-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
          </svg>
          <span>${message}</span>
        `;

        container.appendChild(toast);

        // Animate in
        requestAnimationFrame(() => {
          toast.classList.remove('translate-y-4', 'opacity-0');
        });

        // Auto remove
        setTimeout(() => {
          toast.classList.add('opacity-0', 'translate-y-2');
          setTimeout(() => toast.remove(), 300);
        }, 2500);
      };
    </script>
    <!-- Global Client-side i18n Script (Multi-page Support) -->
    {loadGlobalI18n && <script is:inline defer src="/scripts/i18n.js"></script>}
  </body>
</html>
