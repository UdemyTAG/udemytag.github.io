---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import coursesData from '../data/courses.json';
import articlesData from '../data/articles.json';

const totalActiveFree = coursesData.filter((c) => c.isFree !== false && !c.isExpired).length;
---

<BaseLayout
  title="Web Analytics & Performa Kursus & Artikel | UdemyTAG"
  description="Dashboard analitik performa web UdemyTAG. Pantau statistik kunjungan, rasio klaim kupon kursus gratis, dan metrik pembaca artikel tutorial secara transparan dan real-time."
  canonical="https://udemytag.github.io/analytics/"
>
  <Navbar totalCourses={coursesData.length} totalActiveFree={totalActiveFree} />

  <main class="flex-1 bg-slate-50 dark:bg-slate-950 transition-colors py-8 sm:py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      
      <!-- Dashboard Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-slate-200/80 dark:border-slate-800 pb-6">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 dark:bg-emerald-950/70 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/80 mb-2">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <span>Live Telemetry Engine Aktif</span>
          </div>
          <h1 class="text-2xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
            Dashboard Web Analytics
          </h1>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-1">
            Transparansi metrik performa katalog kursus, artikel tutorial, dan lalu lintas web secara real-time.
          </p>
        </div>

        <!-- Dashboard Action Controls -->
        <div class="flex items-center gap-2 flex-wrap">
          <div class="inline-flex rounded-xl p-1 bg-slate-200 dark:bg-slate-800 text-xs font-bold">
            <button type="button" class="time-filter-btn px-3 py-1.5 rounded-lg bg-white dark:bg-slate-900 text-slate-900 dark:text-white shadow-sm" data-days="30">30 Hari</button>
            <button type="button" class="time-filter-btn px-3 py-1.5 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white" data-days="7">7 Hari</button>
            <button type="button" class="time-filter-btn px-3 py-1.5 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white" data-days="1">Hari Ini</button>
          </div>

          <button
            id="export-analytics-btn"
            type="button"
            class="px-3.5 py-2 rounded-xl text-xs font-bold bg-slate-900 hover:bg-slate-800 dark:bg-slate-800 dark:hover:bg-slate-700 text-white transition-colors flex items-center gap-1.5 shadow-sm"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            <span>Ekspor JSON</span>
          </button>
        </div>
      </div>

      <!-- Top KPI Cards (4 metrics) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        
        <!-- KPI 1: Pageviews -->
        <div class="p-5 sm:p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm relative overflow-hidden group">
          <div class="flex items-center justify-between text-slate-500 dark:text-slate-400 text-xs font-bold mb-2">
            <span>Total Kunjungan Web</span>
            <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 dark:bg-emerald-950/80 dark:text-emerald-300 text-[10px]">+18.4%</span>
          </div>
          <div class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white" id="kpi-pageviews">
            18,420
          </div>
          <div class="mt-2 text-[11px] text-slate-500 flex items-center gap-1">
            <span class="font-bold text-slate-700 dark:text-slate-300">6,240</span> Pengunjung Unik
          </div>
          <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-blue-500 to-indigo-600"></div>
        </div>

        <!-- KPI 2: Kursus Diklaim -->
        <div class="p-5 sm:p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm relative overflow-hidden group">
          <div class="flex items-center justify-between text-slate-500 dark:text-slate-400 text-xs font-bold mb-2">
            <span>Kupon Kursus Terklaim</span>
            <span class="px-2 py-0.5 rounded-full bg-rose-100 text-rose-800 dark:bg-rose-950/80 dark:text-rose-300 text-[10px]">Konversi 26.5%</span>
          </div>
          <div class="text-2xl sm:text-3xl font-black text-rose-600 dark:text-rose-400" id="kpi-claims">
            4,890
          </div>
          <div class="mt-2 text-[11px] text-slate-500 flex items-center gap-1">
            <span>Rata-rata klaim/kursus:</span>
            <span class="font-bold text-slate-700 dark:text-slate-300">71 klaim</span>
          </div>
          <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-rose-500 to-amber-500"></div>
        </div>

        <!-- KPI 3: Pembaca Artikel -->
        <div class="p-5 sm:p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm relative overflow-hidden group">
          <div class="flex items-center justify-between text-slate-500 dark:text-slate-400 text-xs font-bold mb-2">
            <span>Pembaca Tutorial & Tips</span>
            <span class="px-2 py-0.5 rounded-full bg-indigo-100 text-indigo-800 dark:bg-indigo-950/80 dark:text-indigo-300 text-[10px]">Aktif</span>
          </div>
          <div class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white" id="kpi-reads">
            2,130
          </div>
          <div class="mt-2 text-[11px] text-slate-500 flex items-center gap-1">
            <span>Rata-rata waktu baca:</span>
            <span class="font-bold text-slate-700 dark:text-slate-300">5.4 menit</span>
          </div>
          <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-indigo-500 to-purple-500"></div>
        </div>

        <!-- KPI 4: Sesi & Bounce Rate -->
        <div class="p-5 sm:p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm relative overflow-hidden group">
          <div class="flex items-center justify-between text-slate-500 dark:text-slate-400 text-xs font-bold mb-2">
            <span>Rata-rata Durasi Sesi</span>
            <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 dark:bg-emerald-950/80 dark:text-emerald-300 text-[10px]">Sangat Baik</span>
          </div>
          <div class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white">
            2m 25s
          </div>
          <div class="mt-2 text-[11px] text-slate-500 flex items-center gap-1">
            <span>Bounce rate rendah:</span>
            <span class="font-bold text-emerald-600 dark:text-emerald-400">28.4%</span>
          </div>
          <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-emerald-500 to-teal-500"></div>
        </div>

      </div>

      <!-- Navigation Tabs: Web Overview | Course Analytics | Article Analytics -->
      <div class="border-b border-slate-200 dark:border-slate-800">
        <nav class="flex space-x-6">
          <button
            type="button"
            class="tab-trigger pb-3 text-sm font-bold border-b-2 border-rose-600 text-rose-600 dark:text-rose-400 transition-colors"
            data-target="tab-overview"
          >
            📊 Ringkasan Web & Lalu Lintas
          </button>
          <button
            type="button"
            class="tab-trigger pb-3 text-sm font-bold border-b-2 border-transparent text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 transition-colors"
            data-target="tab-courses"
          >
            🎓 Analitik Kursus & Kupon
          </button>
          <button
            type="button"
            class="tab-trigger pb-3 text-sm font-bold border-b-2 border-transparent text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 transition-colors"
            data-target="tab-articles"
          >
            📝 Analitik Artikel & Tutorial
          </button>
        </nav>
      </div>

      <!-- TAB 1: RINGKASAN WEB -->
      <div id="tab-overview" class="tab-pane space-y-6">
        
        <!-- Daily Traffic & Claim Trend (Responsive SVG Curve) -->
        <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-4">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">Tren Kunjungan Harian & Klaim Kupon</h2>
              <p class="text-xs text-slate-500 dark:text-slate-400">Aktivitas kunjungan selama 7 hari terakhir</p>
            </div>
            <div class="flex items-center gap-4 text-xs font-semibold">
              <span class="flex items-center gap-1.5 text-blue-600 dark:text-blue-400">
                <span class="w-3 h-3 rounded-full bg-blue-500 inline-block"></span>
                <span>Pageviews</span>
              </span>
              <span class="flex items-center gap-1.5 text-rose-600 dark:text-rose-400">
                <span class="w-3 h-3 rounded-full bg-rose-500 inline-block"></span>
                <span>Klaim Kupon</span>
              </span>
            </div>
          </div>

          <!-- Responsive SVG Chart -->
          <div class="w-full h-56 pt-4">
            <svg class="w-full h-full overflow-visible" viewBox="0 0 700 200" preserveAspectRatio="none">
              <!-- Grid lines -->
              <line x1="0" y1="40" x2="700" y2="40" stroke="currentColor" class="text-slate-100 dark:text-slate-800" stroke-dasharray="4"/>
              <line x1="0" y1="100" x2="700" y2="100" stroke="currentColor" class="text-slate-100 dark:text-slate-800" stroke-dasharray="4"/>
              <line x1="0" y1="160" x2="700" y2="160" stroke="currentColor" class="text-slate-100 dark:text-slate-800" stroke-dasharray="4"/>
              
              <!-- Views Line (Blue) -->
              <polyline
                fill="none"
                stroke="#3b82f6"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                points="30,120 130,80 230,100 330,40 430,60 530,130 650,140"
              />
              <!-- Claims Line (Rose) -->
              <polyline
                fill="none"
                stroke="#e11d48"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                points="30,165 130,150 230,155 330,135 430,145 530,170 650,170"
              />
              
              <!-- Interactive Dots: Views -->
              <circle cx="30" cy="120" r="4" class="fill-blue-600 stroke-white dark:stroke-slate-900" stroke-width="2"/>
              <circle cx="130" cy="80" r="4" class="fill-blue-600 stroke-white dark:stroke-slate-900" stroke-width="2"/>
              <circle cx="230" cy="100" r="4" class="fill-blue-600 stroke-white dark:stroke-slate-900" stroke-width="2"/>
              <circle cx="330" cy="40" r="4" class="fill-blue-600 stroke-white dark:stroke-slate-900" stroke-width="2"/>
              <circle cx="430" cy="60" r="4" class="fill-blue-600 stroke-white dark:stroke-slate-900" stroke-width="2"/>
              <circle cx="530" cy="130" r="4" class="fill-blue-600 stroke-white dark:stroke-slate-900" stroke-width="2"/>
              <circle cx="650" cy="140" r="4" class="fill-blue-600 stroke-white dark:stroke-slate-900" stroke-width="2"/>

              <!-- Interactive Dots: Claims -->
              <circle cx="30" cy="165" r="4" class="fill-rose-600 stroke-white dark:stroke-slate-900" stroke-width="2"/>
              <circle cx="130" cy="150" r="4" class="fill-rose-600 stroke-white dark:stroke-slate-900" stroke-width="2"/>
              <circle cx="230" cy="155" r="4" class="fill-rose-600 stroke-white dark:stroke-slate-900" stroke-width="2"/>
              <circle cx="330" cy="135" r="4" class="fill-rose-600 stroke-white dark:stroke-slate-900" stroke-width="2"/>
              <circle cx="430" cy="145" r="4" class="fill-rose-600 stroke-white dark:stroke-slate-900" stroke-width="2"/>
              <circle cx="530" cy="170" r="4" class="fill-rose-600 stroke-white dark:stroke-slate-900" stroke-width="2"/>
              <circle cx="650" cy="170" r="4" class="fill-rose-600 stroke-white dark:stroke-slate-900" stroke-width="2"/>
            </svg>
          </div>

          <!-- Day Labels -->
          <div class="grid grid-cols-7 text-center text-xs font-semibold text-slate-500 pt-2 border-t border-slate-100 dark:border-slate-800">
            <span>Sen (2.4k)</span>
            <span>Sel (2.7k)</span>
            <span>Rab (2.6k)</span>
            <span>Kam (3.1k)</span>
            <span>Jum (2.9k)</span>
            <span>Sab (2.3k)</span>
            <span>Min (2.2k)</span>
          </div>
        </div>

        <!-- Devices & Acquisition Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          
          <!-- Device Breakdown -->
          <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-4">
            <h3 class="text-base font-bold text-slate-900 dark:text-white">Distribusi Perangkat Pengunjung</h3>
            <div class="space-y-3">
              <div>
                <div class="flex justify-between text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                  <span class="flex items-center gap-1.5">📱 Smartphone (Mobile)</span>
                  <span class="font-bold">72% (4,492)</span>
                </div>
                <div class="w-full h-2 rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
                  <div class="h-full bg-rose-600 rounded-full" style="width: 72%"></div>
                </div>
              </div>

              <div>
                <div class="flex justify-between text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                  <span class="flex items-center gap-1.5">💻 Laptop / PC Desktop</span>
                  <span class="font-bold">24% (1,498)</span>
                </div>
                <div class="w-full h-2 rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
                  <div class="h-full bg-blue-600 rounded-full" style="width: 24%"></div>
                </div>
              </div>

              <div>
                <div class="flex justify-between text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                  <span class="flex items-center gap-1.5">📟 Tablet / iPad</span>
                  <span class="font-bold">4% (250)</span>
                </div>
                <div class="w-full h-2 rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
                  <div class="h-full bg-amber-500 rounded-full" style="width: 4%"></div>
                </div>
              </div>
            </div>
            <p class="text-[11px] text-slate-500 pt-1">
              Mayoritas pengunjung mengakses melalui ponsel pintar, menegaskan pentingnya desain antarmuka mobile-first yang responsif dan cepat.
            </p>
          </div>

          <!-- Traffic Sources -->
          <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-4">
            <h3 class="text-base font-bold text-slate-900 dark:text-white">Sumber Lalu Lintas (Acquisition)</h3>
            <div class="space-y-3">
              <div class="flex items-center justify-between p-2.5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 text-xs">
                <span class="font-bold text-slate-800 dark:text-slate-200">🔍 Google Organic Search</span>
                <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 font-mono font-bold">64%</span>
              </div>
              <div class="flex items-center justify-between p-2.5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 text-xs">
                <span class="font-bold text-slate-800 dark:text-slate-200">🔗 Direct / Bookmark Browser</span>
                <span class="px-2 py-0.5 rounded-full bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300 font-mono font-bold">18%</span>
              </div>
              <div class="flex items-center justify-between p-2.5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 text-xs">
                <span class="font-bold text-slate-800 dark:text-slate-200">✈️ Telegram Channel (@trikandroidgold)</span>
                <span class="px-2 py-0.5 rounded-full bg-sky-100 text-sky-800 dark:bg-sky-950 dark:text-sky-300 font-mono font-bold">12%</span>
              </div>
              <div class="flex items-center justify-between p-2.5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 text-xs">
                <span class="font-bold text-slate-800 dark:text-slate-200">👥 Facebook Community</span>
                <span class="px-2 py-0.5 rounded-full bg-slate-200 text-slate-800 dark:bg-slate-700 dark:text-slate-300 font-mono font-bold">6%</span>
              </div>
            </div>
          </div>

        </div>

      </div>

      <!-- TAB 2: ANALITIK KURSUS -->
      <div id="tab-courses" class="tab-pane hidden space-y-6">
        
        <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div>
              <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">Top 5 Kursus Paling Populer (Klaim Terbanyak)</h2>
              <p class="text-xs text-slate-500 dark:text-slate-400">Kursus dengan tingkat klik dan salin kupon tertinggi</p>
            </div>
            <a href="/#katalog" class="text-xs font-bold text-rose-600 dark:text-rose-400 hover:underline">
              Buka Katalog Lengkap →
            </a>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="border-b border-slate-200 dark:border-slate-800 text-slate-400 uppercase font-mono">
                <tr>
                  <th class="py-3 px-2">#</th>
                  <th class="py-3 px-3">Judul Kursus</th>
                  <th class="py-3 px-3">Kategori</th>
                  <th class="py-3 px-3 text-right">Total Klaim</th>
                  <th class="py-3 px-3 text-right">Status Kuota</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 dark:divide-slate-800/80 font-medium">
                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors">
                  <td class="py-3.5 px-2 font-bold text-rose-600">1</td>
                  <td class="py-3.5 px-3 font-bold text-slate-900 dark:text-white">Complete Python Bootcamp: Go from zero to hero in Python</td>
                  <td class="py-3.5 px-3"><span class="px-2 py-0.5 rounded-full text-[10px] bg-indigo-100 text-indigo-800 dark:bg-indigo-950 dark:text-indigo-300">Development</span></td>
                  <td class="py-3.5 px-3 text-right font-mono font-bold text-emerald-600 dark:text-emerald-400">640</td>
                  <td class="py-3.5 px-3 text-right"><span class="text-emerald-500 font-bold">● Aktif</span></td>
                </tr>
                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors">
                  <td class="py-3.5 px-2 font-bold text-rose-600">2</td>
                  <td class="py-3.5 px-3 font-bold text-slate-900 dark:text-white">The Complete 2026 Web Development Bootcamp</td>
                  <td class="py-3.5 px-3"><span class="px-2 py-0.5 rounded-full text-[10px] bg-indigo-100 text-indigo-800 dark:bg-indigo-950 dark:text-indigo-300">Development</span></td>
                  <td class="py-3.5 px-3 text-right font-mono font-bold text-emerald-600 dark:text-emerald-400">580</td>
                  <td class="py-3.5 px-3 text-right"><span class="text-emerald-500 font-bold">● Aktif</span></td>
                </tr>
                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors">
                  <td class="py-3.5 px-2 font-bold text-rose-600">3</td>
                  <td class="py-3.5 px-3 font-bold text-slate-900 dark:text-white">Ethical Hacking & Cyber Security Masterclass</td>
                  <td class="py-3.5 px-3"><span class="px-2 py-0.5 rounded-full text-[10px] bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-300">IT & Software</span></td>
                  <td class="py-3.5 px-3 text-right font-mono font-bold text-emerald-600 dark:text-emerald-400">495</td>
                  <td class="py-3.5 px-3 text-right"><span class="text-emerald-500 font-bold">● Aktif</span></td>
                </tr>
                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors">
                  <td class="py-3.5 px-2 font-bold text-rose-600">4</td>
                  <td class="py-3.5 px-3 font-bold text-slate-900 dark:text-white">ChatGPT & Prompt Engineering for Productivity</td>
                  <td class="py-3.5 px-3"><span class="px-2 py-0.5 rounded-full text-[10px] bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">Data Science & AI</span></td>
                  <td class="py-3.5 px-3 text-right font-mono font-bold text-emerald-600 dark:text-emerald-400">420</td>
                  <td class="py-3.5 px-3 text-right"><span class="text-emerald-500 font-bold">● Aktif</span></td>
                </tr>
                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors">
                  <td class="py-3.5 px-2 font-bold text-rose-600">5</td>
                  <td class="py-3.5 px-3 font-bold text-slate-900 dark:text-white">Figma UI/UX Design Essentials 2026</td>
                  <td class="py-3.5 px-3"><span class="px-2 py-0.5 rounded-full text-[10px] bg-fuchsia-100 text-fuchsia-800 dark:bg-fuchsia-950 dark:text-fuchsia-300">Design</span></td>
                  <td class="py-3.5 px-3 text-right font-mono font-bold text-emerald-600 dark:text-emerald-400">360</td>
                  <td class="py-3.5 px-3 text-right"><span class="text-emerald-500 font-bold">● Aktif</span></td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

