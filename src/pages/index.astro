---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import HeroSection from '../components/HeroSection.astro';
import CourseCard from '../components/CourseCard.astro';
import SearchBar from '../components/SearchBar.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import Footer from '../components/Footer.astro';
import coursesData from '../data/courses.json';

// Urutan kategori baku
const categoryOrder = [
  'Development',
  'Business',
  'Design',
  'IT & Software',
  'Marketing',
  'Personal Development'
];

// Hitung jumlah kursus per kategori
const categoryCounts: Record<string, number> = {};
coursesData.forEach((course) => {
  const cat = course.category || 'Development';
  categoryCounts[cat] = (categoryCounts[cat] || 0) + 1;
});

const categories = Object.keys(categoryCounts)
  .sort((a, b) => {
    const idxA = categoryOrder.indexOf(a);
    const idxB = categoryOrder.indexOf(b);
    if (idxA !== -1 && idxB !== -1) return idxA - idxB;
    if (idxA !== -1) return -1;
    if (idxB !== -1) return 1;
    return b.localeCompare(a);
  })
  .map((name) => ({
    name,
    count: categoryCounts[name] || 0,
  }));
---

<BaseLayout 
  title="UdemyTAG - Kupon Diskon 100% & Kursus Gratis Udemy Terbaru Hari Ini"
  description="Daftar lengkap kupon diskon 100% dan kursus gratis Udemy legal bersertifikat. Update otomatis setiap 6 jam dengan akses seumur hidup."
  courses={coursesData}
>
  <div id="top"></div>
  
  <Navbar totalCourses={coursesData.length} />
  
  <main class="flex-1">
    <HeroSection totalCourses={coursesData.length} />

    <!-- Catalog Section -->
    <section id="katalog" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
      
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
        <div>
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-bold bg-rose-100 dark:bg-rose-950/60 text-rose-700 dark:text-rose-300 mb-2">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
            <span>Katalog Terverifikasi</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            Eksplorasi Kupon Kursus Gratis
          </h2>
          <p class="text-sm text-slate-600 dark:text-slate-400 mt-1">
            Gunakan filter pencarian instan untuk menemukan materi yang sesuai dengan target belajar Anda.
          </p>
        </div>
      </div>

      <!-- Search & Filters Toolbar -->
      <div class="space-y-4 mb-8 bg-slate-100/70 dark:bg-slate-900/50 p-4 sm:p-5 rounded-3xl border border-slate-200/80 dark:border-slate-800">
        <SearchBar totalCount={coursesData.length} />
        <CategoryFilter categories={categories} />
      </div>

      <!-- Course Cards Grid -->
      <div 
        id="courses-grid" 
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"
      >
        {coursesData.map((course) => (
          <CourseCard course={course} />
        ))}
      </div>

      <!-- Empty State -->
      <div 
        id="empty-state" 
        class="hidden py-16 px-4 text-center max-w-md mx-auto"
      >
        <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-slate-100 dark:bg-slate-800 text-slate-400 flex items-center justify-center">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">
          Tidak ada kursus yang cocok
        </h3>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1 mb-6">
          Kriteria pencarian Anda tidak menemukan hasil apapun. Cobalah menggunakan kata kunci yang lebih umum.
        </p>
        <button
          id="reset-filter-btn"
          type="button"
          class="px-5 py-2.5 rounded-xl text-xs font-bold bg-rose-600 hover:bg-rose-500 text-white shadow-md shadow-rose-600/30 transition-all"
        >
          Reset Pencarian & Kategori
        </button>
      </div>

    </section>

    <!-- FAQ Section -->
    <section id="faq" class="border-t border-slate-200/80 dark:border-slate-800 bg-white/50 dark:bg-slate-900/30 py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center mb-12">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            Pertanyaan yang Sering Diajukan (FAQ)
          </h2>
          <p class="text-sm text-slate-600 dark:text-slate-400 mt-2">
            Panduan lengkap memanfaatkan kupon diskon 100% Udemy secara optimal.
          </p>
        </div>

        <div class="space-y-4">
          
          <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span class="text-rose-500">Q:</span> Bagaimana cara klaim kursus agar harganya menjadi Rp0?
            </h3>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              Klik tombol <strong>"Buka di Udemy"</strong> pada kartu kursus. Tautan tersebut sudah secara otomatis menyematkan kode kupon diskon 100%. Pastikan harga yang tertera di halaman kursus Udemy adalah <strong>Free / Gratis (Rp0)</strong> sebelum menekan tombol "Daftar Sekarang" (Enroll Now).
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span class="text-rose-500">Q:</span> Mengapa saat saya buka, harganya kembali normal/berbayar?
            </h3>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              Kupon diskon 100% yang diterbitkan oleh instruktur Udemy memiliki <strong>batas kuota maksimal</strong> (biasanya 500 hingga 1.000 klaim di seluruh dunia) atau batas waktu tertentu (1 - 3 hari). Jika kuota klaim telah habis, Udemy otomatis mengembalikan harga ke nominal semula. Selalu klaim secepatnya saat kursus baru muncul di UdemyTAG.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span class="text-rose-500">Q:</span> Apakah kursus yang diklaim gratis tetap mendapatkan Sertifikat Resmi?
            </h3>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              <strong>Ya, 100% resmi!</strong> Karena kursus ini didaftarkan menggunakan kupon diskon resmi dari pembuat kursus, Anda terdaftar sebagai siswa resmi dan berhak mendapatkan sertifikat kelulusan digital (Certificate of Completion) setelah menyelesaikan seluruh materi.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span class="text-rose-500">Q:</span> Apakah akses materi kursus berlaku seumur hidup?
            </h3>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              Ya, setelah berhasil menambahkan kursus ke akun Udemy Anda, kursus tersebut akan tersimpan permanen di menu "My Learning" dan dapat diakses kapan saja tanpa batas waktu kedaluwarsa.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span class="text-rose-500">Q:</span> Seberapa sering UdemyTAG memperbarui daftar kursus?
            </h3>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              UdemyTAG menggunakan sistem CI/CD GitHub Actions terotomatisasi yang melakukan sinkronisasi data langsung dari Google Sheets setiap <strong>6 jam sekali</strong> untuk memastikan Anda selalu mendapatkan kupon yang masih segar dan aktif.
            </p>
          </div>

        </div>

      </div>
    </section>

  </main>

  <Footer />

</BaseLayout>

<!-- Client-side Interactive Filter & Search Logic -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('search-input');
    const clearSearchBtn = document.getElementById('clear-search-btn');
    const sortSelect = document.getElementById('sort-select');
    const filteredCountSpan = document.getElementById('filtered-count');
    const coursesGrid = document.getElementById('courses-grid');
    const emptyState = document.getElementById('empty-state');
    const resetFilterBtn = document.getElementById('reset-filter-btn');
    const categoryButtons = document.querySelectorAll('.cat-filter-btn');
    const copyButtons = document.querySelectorAll('.copy-coupon-btn');

    let currentCategory = 'all';
    let searchQuery = '';
    let currentSort = 'default';

    // Shortcut '/' untuk fokus ke input pencarian
    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== searchInput) {
        e.preventDefault();
        searchInput?.focus();
      }
    });

    // Helper filter kursus
    function filterAndSortCourses() {
      const cards = Array.from(document.querySelectorAll('.course-card'));
      let visibleCount = 0;

      cards.forEach((card) => {
        const title = card.getAttribute('data-title') || '';
        const category = card.getAttribute('data-category') || '';
        const instructor = card.getAttribute('data-instructor') || '';

        const matchesCategory = currentCategory === 'all' || category === currentCategory;
        const matchesQuery = 
          searchQuery === '' ||
          title.includes(searchQuery) ||
          category.includes(searchQuery) ||
          instructor.includes(searchQuery);

        if (matchesCategory && matchesQuery) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      // Update urutan jika perlu
      if (currentSort !== 'default') {
        const sortedCards = [...cards].sort((a, b) => {
          if (currentSort === 'rating-desc') {
            const rA = parseFloat(a.getAttribute('data-rating') || '0');
            const rB = parseFloat(b.getAttribute('data-rating') || '0');
            return rB - rA;
          } else if (currentSort === 'title-asc') {
            const tA = a.getAttribute('data-title') || '';
            const tB = b.getAttribute('data-title') || '';
            return tA.localeCompare(tB);
          }
          return 0;
        });

        sortedCards.forEach((card) => coursesGrid.appendChild(card));
      }

      // Update hitungan
      if (filteredCountSpan) {
        filteredCountSpan.textContent = visibleCount.toString();
      }

      // Tampilkan/sembunyikan empty state
      if (visibleCount === 0) {
        emptyState?.classList.remove('hidden');
        coursesGrid?.classList.add('hidden');
      } else {
        emptyState?.classList.add('hidden');
        coursesGrid?.classList.remove('hidden');
      }
    }

    // Event input pencarian
    searchInput?.addEventListener('input', (e) => {
      searchQuery = e.target.value.trim().toLowerCase();
      if (searchQuery.length > 0) {
        clearSearchBtn?.classList.remove('hidden');
      } else {
        clearSearchBtn?.classList.add('hidden');
      }
      filterAndSortCourses();
    });

    // Clear search button
    clearSearchBtn?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        searchQuery = '';
        clearSearchBtn.classList.add('hidden');
        filterAndSortCourses();
        searchInput.focus();
      }
    });

    // Filter kategori buttons
    categoryButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-category') || 'all';
        currentCategory = cat;

        // Update styling tombol aktif
        categoryButtons.forEach((b) => {
          b.className = 'cat-filter-btn px-4 py-2 rounded-xl text-xs font-semibold transition-all duration-200 flex items-center gap-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:border-rose-500/50 hover:text-rose-600 dark:hover:text-rose-400 shadow-sm';
        });

        btn.className = 'cat-filter-btn px-4 py-2 rounded-xl text-xs font-bold transition-all duration-200 flex items-center gap-2 bg-rose-600 text-white shadow-md shadow-rose-600/25 ring-2 ring-rose-600/30';

        filterAndSortCourses();
      });
    });

    // Sort select
    sortSelect?.addEventListener('change', (e) => {
      currentSort = e.target.value;
      filterAndSortCourses();
    });

    // Reset filter button
    resetFilterBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      clearSearchBtn?.classList.add('hidden');
      currentCategory = 'all';

      // Reset tombol kategori ke 'all'
      categoryButtons.forEach((b) => {
        const isAll = b.getAttribute('data-category') === 'all';
        if (isAll) {
          b.className = 'cat-filter-btn px-4 py-2 rounded-xl text-xs font-bold transition-all duration-200 flex items-center gap-2 bg-rose-600 text-white shadow-md shadow-rose-600/25 ring-2 ring-rose-600/30';
        } else {
          b.className = 'cat-filter-btn px-4 py-2 rounded-xl text-xs font-semibold transition-all duration-200 flex items-center gap-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:border-rose-500/50 hover:text-rose-600 dark:hover:text-rose-400 shadow-sm';
        }
      });

      if (sortSelect) sortSelect.value = 'default';
      currentSort = 'default';

      filterAndSortCourses();
    });

    // Salin Kupon Interaction
    copyButtons.forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        const coupon = btn.getAttribute('data-coupon') || '100% OFF';
        const copyIcon = btn.querySelector('.copy-icon');
        const checkIcon = btn.querySelector('.check-icon');
        const btnText = btn.querySelector('.btn-text');

        try {
          await navigator.clipboard.writeText(coupon);

          // Animasi Feedback
          copyIcon?.classList.add('hidden');
          checkIcon?.classList.remove('hidden');
          if (btnText) btnText.textContent = 'Tersalin!';
          btn.classList.add('border-emerald-500', 'text-emerald-600', 'dark:text-emerald-400');

          if (window.showToast) {
            window.showToast(`Kupon "${coupon}" berhasil disalin!`);
          }

          setTimeout(() => {
            copyIcon?.classList.remove('hidden');
            checkIcon?.classList.add('hidden');
            if (btnText) btnText.textContent = 'Salin Kupon';
            btn.classList.remove('border-emerald-500', 'text-emerald-600', 'dark:text-emerald-400');
          }, 2000);
        } catch (err) {
          console.error('Gagal menyalin:', err);
          if (window.showToast) {
            window.showToast(`Gagal menyalin kode kupon`, 'error');
          }
        }
      });
    });

  });
</script>
