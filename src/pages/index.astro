    function applyLanguage(lang) {
      currentLang = lang;
      try {
        localStorage.setItem('lang', lang);
      } catch (_) {}
      document.documentElement.lang = lang;

      // Update toggle button text & aria-label
      if (langCurrentLabel) {
        langCurrentLabel.textContent = lang.toUpperCase();
      }
      if (langToggleBtn) {
        langToggleBtn.setAttribute(
          'aria-label',
          lang === 'id' ? 'ID - Ganti Bahasa (Switch Language)' : 'EN - Switch Language (Ganti Bahasa)'
        );
      }

      const dict = i18n[lang] || i18n.id;

      // Only mutate DOM if language is NOT default Indonesian ('id')
      // HTML is already server-rendered in Indonesian, re-assigning text destroys LCP performance!
      if (lang === 'en') {
        // Update elements with data-i18n
        document.querySelectorAll('[data-i18n]').forEach((el) => {
          const key = el.getAttribute('data-i18n');
          if (dict[key]) {
            if (typeof dict[key] === 'function') {
              const total = allCoursesData.length || 69;
              el.innerHTML = dict[key](total);
            } else {
              el.innerHTML = dict[key];
            }
          }
        });

        // Update search input placeholder
        const searchInputEl = document.getElementById('search-input');
        if (searchInputEl) {
          searchInputEl.placeholder = dict.search_placeholder;
        }

        // Update card buttons & badges
        document.querySelectorAll('.copy-btn-text').forEach((el) => {
          if (!el.closest('.copy-coupon-btn')?.classList.contains('border-emerald-500')) {
            el.textContent = dict.copy_coupon_btn;
