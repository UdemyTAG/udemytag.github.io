        cat_all: 'All',
        load_more_btn: (n) => `Show ${n} More Courses`,
        pagination_status: (displayed, total) => `Showing ${displayed} of ${total} courses`,
        all_loaded: '✓ All courses loaded',
        empty_title: 'No matching courses found',
        empty_desc: 'Your search query did not return any courses. Try different keywords or select All Categories.',
        reset_btn: 'Reset Search',
        copy_coupon_btn: 'Copy Coupon',
        copied_btn: 'Copied!',
        open_udemy_btn: 'Open in Udemy',
        free_label: 'FREE',
        toast_copied: (code) => `Coupon "${code}" copied to clipboard!`,
        faq_section_title: 'Frequently Asked Questions (FAQ)',
        faq_section_subtitle: 'Comprehensive guide to claiming 100% off Udemy coupons effectively.',
        footer_about: 'Curated directory of 100% discount coupons and verified free Udemy courses with certificates and lifetime access.',
        footer_nav_title: 'Navigation',
        footer_nav_catalog: 'All Courses',
        footer_nav_faq: 'How to Claim & FAQ',
        footer_claim_title: 'How to Claim Coupon',
        footer_step_1: 'Click "Open in Udemy" on your selected course.',
        footer_step_2: 'Ensure the price shows Free / $0 before checkout.',
        footer_step_3: 'Click "Enroll Now" to keep the course permanently in your account.',
        footer_disclaimer: '<strong>Disclaimer:</strong> UdemyTAG is an independent directory and is not officially affiliated with or endorsed by Udemy, Inc. All trademarks and content belong to their respective owners. 100% discount coupons have maximum claim quotas determined by the instructors.',
        footer_back_to_top: 'Back to Top',
        faqs: {
          1: {
            q: 'How do I claim a course so the price becomes $0 / Free?',
            a: 'Click the <strong>"Open in Udemy"</strong> button on the course card. The link automatically applies the 100% discount coupon code. Ensure the price displayed on the Udemy course page is <strong>Free ($0)</strong> before clicking "Enroll Now".'
          },
          2: {
            q: 'Why does the course show a price instead of free when I open it?',
            a: '100% discount coupons issued by Udemy instructors have a <strong>maximum claim quota</strong> (typically 500 to 1,000 enrollments worldwide) or a short expiration period (1 to 3 days). Once the quota runs out, Udemy automatically reverts the price to full. Always claim courses as early as possible.'
          },
          3: {
            q: 'Do courses enrolled with free coupons still grant an Official Certificate?',
            a: '<strong>Yes, 100% official!</strong> Because you are enrolling through an official instructor discount coupon, you are registered as a regular student and entitled to a digital Certificate of Completion upon finishing the course.'
          },
          4: {
            q: 'Is access to course materials truly lifetime?',
            a: 'Yes, once successfully added to your Udemy account, the course is permanently saved in your "My Learning" section and accessible anytime with no expiration date.'
          },
          5: {
            q: 'Where can I get real-time updates for new coupon releases?',
            a: 'You can join our Telegram Channel at <a href="https://t.me/trikandroidgold" target="_blank" class="text-rose-600 dark:text-rose-400 font-bold underline hover:opacity-80">@trikandroidgold</a> and follow our Facebook Page at <a href="https://web.facebook.com/Trikandroidgold" target="_blank" class="text-blue-600 dark:text-blue-400 font-bold underline hover:opacity-80">@Trikandroidgold</a> for instant coupon alerts.'
          }
        }
      }
    };

    let currentLang = localStorage.getItem('lang') || 'id';
    const langToggleBtn = document.getElementById('lang-toggle-btn');
    const langCurrentLabel = document.getElementById('lang-current-label');

    function applyLanguage(lang) {
      currentLang = lang;
      localStorage.setItem('lang', lang);
      document.documentElement.lang = lang;

      // Update toggle button text
      if (langCurrentLabel) {
        langCurrentLabel.textContent = lang.toUpperCase();
      }

      const dict = i18n[lang] || i18n.id;

      // Update elements with data-i18n
      document.querySelectorAll('[data-i18n]').forEach((el) => {
        const key = el.getAttribute('data-i18n');
        if (dict[key]) {
          if (typeof dict[key] === 'function') {
            // function like active courses
            const total = document.querySelectorAll('.course-card').length;
            el.innerHTML = dict[key](total);
          } else {
            el.innerHTML = dict[key];
          }
        }
      });

      // Update search input placeholder
      const searchInputEl = document.getElementById('search-input');
      if (searchInputEl) {
        searchInputEl.placeholder = dict.search_placeholder;
      }

      // Update card buttons & badges
      document.querySelectorAll('.copy-btn-text').forEach((el) => {
        if (!el.closest('.copy-coupon-btn')?.classList.contains('border-emerald-500')) {
          el.textContent = dict.copy_coupon_btn;
        }
      });
      document.querySelectorAll('.open-btn-text').forEach((el) => {
        el.textContent = dict.open_udemy_btn;
      });
      document.querySelectorAll('.free-badge-label').forEach((el) => {
        el.textContent = dict.free_label;
      });

      // Update Category "Semua" / "All"
      const catAllLabel = document.querySelector('[data-category="all"] .cat-label');
      if (catAllLabel) {
        catAllLabel.textContent = dict.cat_all;
      }

      // Update FAQ Accordions
      if (dict.faqs) {
        document.querySelectorAll('.faq-q-text').forEach((el) => {
          const id = el.getAttribute('data-faq-id');
          if (dict.faqs[id]) el.innerHTML = dict.faqs[id].q;
        });
        document.querySelectorAll('.faq-a-text').forEach((el) => {
          const id = el.getAttribute('data-faq-id');
          if (dict.faqs[id]) el.innerHTML = dict.faqs[id].a;
        });
      }

      // Update Load more message
      const allLoadedMsg = document.getElementById('all-loaded-message');
      if (allLoadedMsg) allLoadedMsg.textContent = dict.all_loaded;

      // Re-run filter count labels
      if (typeof filterAndSortCourses === 'function') {
        filterAndSortCourses();
      }
    }

    // Language toggle click
    langToggleBtn?.addEventListener('click', () => {
      const nextLang = currentLang === 'id' ? 'en' : 'id';
      applyLanguage(nextLang);
    });

    // -------------------------------------------------------------
    // 2. SEARCH, FILTER & PAGINATION (LOAD MORE)
    // -------------------------------------------------------------
    const searchInput = document.getElementById('search-input');
    const clearSearchBtn = document.getElementById('clear-search-btn');
    const sortSelect = document.getElementById('sort-select');
    const filteredCountSpan = document.getElementById('filtered-count');
    const coursesGrid = document.getElementById('courses-grid');
    const emptyState = document.getElementById('empty-state');
    const resetFilterBtn = document.getElementById('reset-filter-btn');
    const categoryButtons = document.querySelectorAll('.cat-filter-btn');
    const copyButtons = document.querySelectorAll('.copy-coupon-btn');

    // Pagination elements
    const loadMoreBtn = document.getElementById('load-more-btn');
    const loadMoreContainer = document.getElementById('load-more-container');
    const displayedCountSpan = document.getElementById('displayed-count');
    const totalMatchingCountSpan = document.getElementById('total-matching-count');
    const remainingCountBadge = document.getElementById('remaining-count-badge');
    const allLoadedMessage = document.getElementById('all-loaded-message');

    const PAGE_SIZE = 12; // Jumlah kursus per batch
    let visibleLimit = PAGE_SIZE;

    let currentCategory = 'all';
    let searchQuery = '';
    let currentSort = 'default';

    // Shortcut '/' untuk fokus ke input pencarian
    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== searchInput) {
        e.preventDefault();
        searchInput?.focus();
      }
    });

    // Helper filter & paginasi kursus
    function filterAndSortCourses() {
      const dict = i18n[currentLang] || i18n.id;
      const cards = Array.from(document.querySelectorAll('.course-card'));
      
      // 1. Tentukan kartu mana yang cocok dengan pencarian & kategori
      const matchingCards = [];
      cards.forEach((card) => {
        const title = card.getAttribute('data-title') || '';
        const category = card.getAttribute('data-category') || '';
        const instructor = card.getAttribute('data-instructor') || '';

        const matchesCategory = currentCategory === 'all' || category === currentCategory;
        const matchesQuery = 
          searchQuery === '' ||
          title.includes(searchQuery) ||
          category.includes(searchQuery) ||
          instructor.includes(searchQuery);

        if (matchesCategory && matchesQuery) {
          matchingCards.push(card);
        } else {
          card.classList.add('hidden');
        }
      });

      // 2. Urutkan matching cards jika diperlukan
      if (currentSort !== 'default') {
        matchingCards.sort((a, b) => {
          if (currentSort === 'rating-desc') {
            const rA = parseFloat(a.getAttribute('data-rating') || '0');
            const rB = parseFloat(b.getAttribute('data-rating') || '0');
            return rB - rA;
          } else if (currentSort === 'title-asc') {
            const tA = a.getAttribute('data-title') || '';
            const tB = b.getAttribute('data-title') || '';
            return tA.localeCompare(tB);
          }
          return 0;
        });

        // Re-append ke container sesuai urutan
        matchingCards.forEach((card) => coursesGrid?.appendChild(card));
      }

      const totalMatching = matchingCards.length;

      // 3. Terapkan batas paginasi (Load More)
      let displayedCount = 0;
      matchingCards.forEach((card, index) => {
        if (index < visibleLimit) {
          card.classList.remove('hidden');
          displayedCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      // 4. Update indikator hitungan
      if (filteredCountSpan) filteredCountSpan.textContent = totalMatching.toString();
      if (displayedCountSpan) displayedCountSpan.textContent = displayedCount.toString();
      if (totalMatchingCountSpan) totalMatchingCountSpan.textContent = totalMatching.toString();

      const paginationStatusEl = document.getElementById('pagination-status');
      if (paginationStatusEl) {
        paginationStatusEl.innerHTML = dict.pagination_status(displayedCount, totalMatching);
      }

      // 5. Update status tombol Load More
      const remaining = totalMatching - displayedCount;
      if (remaining > 0) {
        loadMoreBtn?.classList.remove('hidden');
        allLoadedMessage?.classList.add('hidden');
        loadMoreContainer?.classList.remove('hidden');
        if (remainingCountBadge) {
          const nextBatch = Math.min(PAGE_SIZE, remaining);
          remainingCountBadge.textContent = `+${remaining}`;
          const loadMoreText = loadMoreBtn?.querySelector('.load-more-text');
          if (loadMoreText) {
            loadMoreText.textContent = dict.load_more_btn(nextBatch);
          }
        }
      } else {
        loadMoreBtn?.classList.add('hidden');
        if (totalMatching > 0 && totalMatching > PAGE_SIZE) {
          allLoadedMessage?.classList.remove('hidden');
          loadMoreContainer?.classList.remove('hidden');
        } else {
          allLoadedMessage?.classList.add('hidden');
          if (totalMatching <= PAGE_SIZE) {
            loadMoreContainer?.classList.add('hidden');
          }
        }
      }

      // 6. Tampilkan/sembunyikan empty state
      if (totalMatching === 0) {
        emptyState?.classList.remove('hidden');
        coursesGrid?.classList.add('hidden');
        loadMoreContainer?.classList.add('hidden');
      } else {
        emptyState?.classList.add('hidden');
        coursesGrid?.classList.remove('hidden');
      }
    }

    // Event tombol Load More
    loadMoreBtn?.addEventListener('click', () => {
      visibleLimit += PAGE_SIZE;
      filterAndSortCourses();
    });

    // Event input pencarian
    searchInput?.addEventListener('input', (e) => {
      searchQuery = e.target.value.trim().toLowerCase();
      visibleLimit = PAGE_SIZE; // reset batas paginasi
      if (searchQuery.length > 0) {
        clearSearchBtn?.classList.remove('hidden');
      } else {
        clearSearchBtn?.classList.add('hidden');
      }
      filterAndSortCourses();
    });

    // Clear search button
    clearSearchBtn?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        searchQuery = '';
        visibleLimit = PAGE_SIZE;
        clearSearchBtn.classList.add('hidden');
        filterAndSortCourses();
        searchInput.focus();
      }
    });

    // Filter kategori buttons
    categoryButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-category') || 'all';
        currentCategory = cat;
        visibleLimit = PAGE_SIZE; // reset batas paginasi saat ganti kategori

        // Update styling tombol aktif
        categoryButtons.forEach((b) => {
          b.className = 'cat-filter-btn px-2.5 py-1.5 sm:px-3.5 sm:py-2 rounded-xl text-[11px] sm:text-xs font-semibold transition-all duration-200 flex items-center gap-1.5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:border-rose-500/50 hover:text-rose-600 dark:hover:text-rose-400 shadow-sm flex-shrink-0';
        });

        btn.className = 'cat-filter-btn px-3 py-1.5 sm:px-4 sm:py-2 rounded-xl text-[11px] sm:text-xs font-bold transition-all duration-200 flex items-center gap-1.5 bg-rose-600 text-white shadow-sm shadow-rose-600/25 ring-2 ring-rose-600/30 flex-shrink-0';

        filterAndSortCourses();
      });
    });

    // Sort select
    sortSelect?.addEventListener('change', (e) => {
      currentSort = e.target.value;
      visibleLimit = PAGE_SIZE;
      filterAndSortCourses();
    });

    // Reset filter button
    resetFilterBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      clearSearchBtn?.classList.add('hidden');
      currentCategory = 'all';
      visibleLimit = PAGE_SIZE;

      // Reset tombol kategori ke 'all'
      categoryButtons.forEach((b) => {
        const isAll = b.getAttribute('data-category') === 'all';
        if (isAll) {
          b.className = 'cat-filter-btn px-3 py-1.5 sm:px-4 sm:py-2 rounded-xl text-[11px] sm:text-xs font-bold transition-all duration-200 flex items-center gap-1.5 bg-rose-600 text-white shadow-sm shadow-rose-600/25 ring-2 ring-rose-600/30 flex-shrink-0';
        } else {
          b.className = 'cat-filter-btn px-2.5 py-1.5 sm:px-3.5 sm:py-2 rounded-xl text-[11px] sm:text-xs font-semibold transition-all duration-200 flex items-center gap-1.5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:border-rose-500/50 hover:text-rose-600 dark:hover:text-rose-400 shadow-sm flex-shrink-0';
        }
      });

      if (sortSelect) sortSelect.value = 'default';
      currentSort = 'default';

      filterAndSortCourses();
    });

    // Salin Kupon Interaction
    copyButtons.forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        const coupon = btn.getAttribute('data-coupon') || '100% OFF';
        const copyIcon = btn.querySelector('.copy-icon');
        const checkIcon = btn.querySelector('.check-icon');
        const btnText = btn.querySelector('.btn-text');
        const dict = i18n[currentLang] || i18n.id;

        try {
          await navigator.clipboard.writeText(coupon);

          // Animasi Feedback
          copyIcon?.classList.add('hidden');
          checkIcon?.classList.remove('hidden');
          if (btnText) btnText.textContent = dict.copied_btn;
          btn.classList.add('border-emerald-500', 'text-emerald-600', 'dark:text-emerald-400');

          if (window.showToast) {
            window.showToast(dict.toast_copied(coupon));
          }

          setTimeout(() => {
            copyIcon?.classList.remove('hidden');
            checkIcon?.classList.add('hidden');
            if (btnText) btnText.textContent = dict.copy_coupon_btn;
            btn.classList.remove('border-emerald-500', 'text-emerald-600', 'dark:text-emerald-400');
          }, 2000);
        } catch (err) {
          console.error('Gagal menyalin:', err);
          if (window.showToast) {
            window.showToast(`Gagal menyalin kode kupon`, 'error');
          }
        }
      });
    });

    // Salin Link Khusus untuk Post Fanspage Facebook
    const copyPostLinkButtons = document.querySelectorAll('.copy-post-link-btn');
    copyPostLinkButtons.forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const link = btn.getAttribute('data-link') || '';
        const linkIcon = btn.querySelector('.link-icon');
        const checkIcon = btn.querySelector('.link-check-icon');

        try {
          await navigator.clipboard.writeText(link);
          linkIcon?.classList.add('hidden');
          checkIcon?.classList.remove('hidden');
          btn.classList.add('border-emerald-500', 'text-emerald-600', 'dark:text-emerald-400');

          if (window.showToast) {
            window.showToast(currentLang === 'id' 
              ? 'Link khusus posting Facebook berhasil disalin!' 
              : 'Course post link copied to clipboard!');
          }

          setTimeout(() => {
            linkIcon?.classList.remove('hidden');
            checkIcon?.classList.add('hidden');
            btn.classList.remove('border-emerald-500', 'text-emerald-600', 'dark:text-emerald-400');
          }, 2000);
        } catch (err) {
          console.error('Gagal menyalin link:', err);
        }
      });
    });

    // Auto-scroll & Highlight jika dibuka via link khusus misal #course-5 atau ?course=course-5
    const hash = window.location.hash.replace('#', '');
    const urlParams = new URLSearchParams(window.location.search);
    const targetCourseId = hash.startsWith('course-') ? hash : urlParams.get('course') || urlParams.get('c');

    if (targetCourseId) {
      const targetCard = document.getElementById(targetCourseId);
      if (targetCard) {
        visibleLimit = 80;
        filterAndSortCourses();
        setTimeout(() => {
          targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
          targetCard.classList.add('ring-4', 'ring-rose-500', 'ring-offset-2');
          setTimeout(() => {
            targetCard.classList.remove('ring-4', 'ring-rose-500', 'ring-offset-2');
          }, 3500);
        }, 300);
      }
    }

    // Terapkan bahasa saat inisialisasi awal
    applyLanguage(currentLang);

  });
</script>
