              >
                <svg class="link-icon w-3.5 h-3.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                  <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 7.07 7.07l1.71-1.71"/>
                </svg>
                <svg class="link-check-icon hidden w-3.5 h-3.5 text-emerald-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
                <span class="link-btn-text copy-link-text truncate">${currentLang === 'en' ? 'Copy Link' : 'Salin Link'}</span>
              </button>
            </div>
          </div>
        </div>
      `;
      return article;
    }

    // Shortcut '/' untuk fokus ke input pencarian
    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== searchInput) {
        e.preventDefault();
        searchInput?.focus();
      }
    });

    // Helper filter & paginasi kursus dengan on-demand rendering (DOM super ringan)
    function filterAndSortCourses() {
      const dict = i18n[currentLang] || i18n.id;
      
      // 1. Filter matching courses dari data JSON
      const matchingCourses = allCoursesData.filter((course) => {
        const cat = (course.category || '').toLowerCase();
        const title = (course.title || '').toLowerCase();
        const instructor = (course.instructor || '').toLowerCase();

        const matchesCategory = currentCategory === 'all' || cat === currentCategory.toLowerCase();
        const matchesQuery = 
          !searchQuery ||
          title.includes(searchQuery) ||
          cat.includes(searchQuery) ||
          instructor.includes(searchQuery);

        return matchesCategory && matchesQuery;
      });

      // 2. Urutkan matching courses jika diperlukan
      if (currentSort === 'rating-desc') {
        matchingCourses.sort((a, b) => parseFloat(b.rating || '0') - parseFloat(a.rating || '0'));
      } else if (currentSort === 'title-asc') {
        matchingCourses.sort((a, b) => (a.title || '').localeCompare(b.title || ''));
      }

      const totalMatching = matchingCourses.length;
      const visibleCourses = matchingCourses.slice(0, visibleLimit);
      const visibleIds = new Set(visibleCourses.map(c => c.id));

      // 3. Render / munculkan kartu yang masuk dalam limit
      visibleCourses.forEach((course) => {
        let card = renderedCardsMap.get(course.id);
        if (!card) {
          card = createCourseCardElement(course);
          renderedCardsMap.set(course.id, card);
        }
        card.classList.remove('hidden');
        coursesGrid?.appendChild(card);
      });

      // 4. Sembunyikan kartu yang tidak ada di daftar visible
      renderedCardsMap.forEach((card, id) => {
        if (!visibleIds.has(id)) {
          card.classList.add('hidden');
        }
      });

      const displayedCount = visibleCourses.length;

      // 5. Update indikator hitungan
      if (filteredCountSpan) filteredCountSpan.textContent = totalMatching.toString();
      if (displayedCountSpan) displayedCountSpan.textContent = displayedCount.toString();
      if (totalMatchingCountSpan) totalMatchingCountSpan.textContent = totalMatching.toString();

      const paginationStatusEl = document.getElementById('pagination-status');
      if (paginationStatusEl) {
        paginationStatusEl.innerHTML = dict.pagination_status(displayedCount, totalMatching);
      }

      // 6. Update status tombol Load More
      const remaining = totalMatching - displayedCount;
      if (remaining > 0) {
        loadMoreBtn?.classList.remove('hidden');
        allLoadedMessage?.classList.add('hidden');
        loadMoreContainer?.classList.remove('hidden');
        if (remainingCountBadge) {
          const nextBatch = Math.min(PAGE_SIZE, remaining);
          remainingCountBadge.textContent = `+${remaining}`;
          const loadMoreText = loadMoreBtn?.querySelector('.load-more-text');
          if (loadMoreText) {
            loadMoreText.textContent = dict.load_more_btn(nextBatch);
          }
        }
      } else {
        loadMoreBtn?.classList.add('hidden');
        if (totalMatching > 0 && totalMatching > PAGE_SIZE) {
          allLoadedMessage?.classList.remove('hidden');
          loadMoreContainer?.classList.remove('hidden');
        } else {
          allLoadedMessage?.classList.add('hidden');
          if (totalMatching <= PAGE_SIZE) {
            loadMoreContainer?.classList.add('hidden');
          }
        }
      }

      // 7. Tampilkan/sembunyikan empty state
      if (totalMatching === 0) {
        emptyState?.classList.remove('hidden');
        coursesGrid?.classList.add('hidden');
        loadMoreContainer?.classList.add('hidden');
      } else {
        emptyState?.classList.add('hidden');
        coursesGrid?.classList.remove('hidden');
      }

      if (typeof window.renderClaimUpdates === 'function') {
        window.renderClaimUpdates();
      }
    }

    // Event tombol Load More
    loadMoreBtn?.addEventListener('click', () => {
      visibleLimit += PAGE_SIZE;
      filterAndSortCourses();
    });

    // Event input pencarian
    searchInput?.addEventListener('input', (e) => {
      searchQuery = e.target.value.trim().toLowerCase();
      visibleLimit = PAGE_SIZE; // reset batas paginasi
      if (searchQuery.length > 0) {
        clearSearchBtn?.classList.remove('hidden');
      } else {
        clearSearchBtn?.classList.add('hidden');
      }
      filterAndSortCourses();
    });

    // Clear search button
    clearSearchBtn?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        searchQuery = '';
        visibleLimit = PAGE_SIZE;
        clearSearchBtn.classList.add('hidden');
        filterAndSortCourses();
        searchInput.focus();
      }
    });

    // Filter kategori buttons
    categoryButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-category') || 'all';
        currentCategory = cat;
        visibleLimit = PAGE_SIZE; // reset batas paginasi saat ganti kategori

        // Update styling tombol aktif
        categoryButtons.forEach((b) => {
          b.className = 'cat-filter-btn px-2.5 py-1.5 sm:px-3.5 sm:py-2 rounded-xl text-[11px] sm:text-xs font-semibold transition-all duration-200 flex items-center gap-1.5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:border-rose-500/50 hover:text-rose-600 dark:hover:text-rose-400 shadow-sm flex-shrink-0';
        });

        btn.className = 'cat-filter-btn px-3 py-1.5 sm:px-4 sm:py-2 rounded-xl text-[11px] sm:text-xs font-bold transition-all duration-200 flex items-center gap-1.5 bg-rose-600 text-white shadow-sm shadow-rose-600/25 ring-2 ring-rose-600/30 flex-shrink-0';

        filterAndSortCourses();
      });
    });

    // Sort select
    sortSelect?.addEventListener('change', (e) => {
      currentSort = e.target.value;
      visibleLimit = PAGE_SIZE;
      filterAndSortCourses();
    });

    // Reset filter button
    resetFilterBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      clearSearchBtn?.classList.add('hidden');
      currentCategory = 'all';
      visibleLimit = PAGE_SIZE;

      // Reset tombol kategori ke 'all'
      categoryButtons.forEach((b) => {
        const isAll = b.getAttribute('data-category') === 'all';
        if (isAll) {
          b.className = 'cat-filter-btn px-3 py-1.5 sm:px-4 sm:py-2 rounded-xl text-[11px] sm:text-xs font-bold transition-all duration-200 flex items-center gap-1.5 bg-rose-600 text-white shadow-sm shadow-rose-600/25 ring-2 ring-rose-600/30 flex-shrink-0';
        } else {
          b.className = 'cat-filter-btn px-2.5 py-1.5 sm:px-3.5 sm:py-2 rounded-xl text-[11px] sm:text-xs font-semibold transition-all duration-200 flex items-center gap-1.5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:border-rose-500/50 hover:text-rose-600 dark:hover:text-rose-400 shadow-sm flex-shrink-0';
        }
      });

      if (sortSelect) sortSelect.value = 'default';
      currentSort = 'default';

      filterAndSortCourses();
    });

    // Delegasi Event Klik pada Courses Grid (Mendukung Kartu Statis & Dinamis)
    coursesGrid?.addEventListener('click', async (e) => {
      // 1. Salin Kupon
      const copyBtn = e.target.closest('.copy-coupon-btn');
      if (copyBtn) {
        e.preventDefault();
        const card = copyBtn.closest('.course-card');
        if (card) recordClaim(card.getAttribute('data-id'));
        const coupon = copyBtn.getAttribute('data-coupon') || '100% OFF';
        const copyIcon = copyBtn.querySelector('.copy-icon');
        const checkIcon = copyBtn.querySelector('.check-icon');
        const btnText = copyBtn.querySelector('.btn-text');
        const dict = i18n[currentLang] || i18n.id;

        try {
          await navigator.clipboard.writeText(coupon);

          copyIcon?.classList.add('hidden');
          checkIcon?.classList.remove('hidden');
          if (btnText) btnText.textContent = dict.copied_btn;
          copyBtn.classList.add('border-emerald-500', 'text-emerald-600', 'dark:text-emerald-400');

          if (window.showToast) {
            window.showToast(dict.toast_copied(coupon));
          }

          setTimeout(() => {
            copyIcon?.classList.remove('hidden');
            checkIcon?.classList.add('hidden');
            if (btnText) btnText.textContent = dict.copy_coupon_btn;
            copyBtn.classList.remove('border-emerald-500', 'text-emerald-600', 'dark:text-emerald-400');
          }, 2000);
        } catch (_) {
          if (window.showToast) {
            window.showToast(`Gagal menyalin kode kupon`, 'error');
          }
        }
        return;
      }

      // 2. Salin Link Halaman Kursus (Tanpa Popup Toast)
      const linkBtn = e.target.closest('.copy-post-link-btn');
      if (linkBtn) {
        e.preventDefault();
        e.stopPropagation();
        const link = linkBtn.getAttribute('data-link') || '';
        const linkIcon = linkBtn.querySelector('.link-icon');
        const checkIcon = linkBtn.querySelector('.link-check-icon');
        const linkText = linkBtn.querySelector('.link-btn-text');
        const isEn = document.documentElement.lang === 'en';

        try {
          await navigator.clipboard.writeText(link);
          linkIcon?.classList.add('hidden');
          checkIcon?.classList.remove('hidden');
          if (linkText) linkText.textContent = isEn ? 'Copied!' : 'Tersalin!';
          linkBtn.classList.add('border-emerald-500', 'text-emerald-600', 'dark:text-emerald-400');

          setTimeout(() => {
            linkIcon?.classList.remove('hidden');
            checkIcon?.classList.add('hidden');
            if (linkText) linkText.textContent = isEn ? 'Copy Link' : 'Salin Link';
            linkBtn.classList.remove('border-emerald-500', 'text-emerald-600', 'dark:text-emerald-400');
          }, 2000);
        } catch (_) {}
        return;
      }
    });

    // Auto-scroll & Highlight jika dibuka via link khusus misal #retail-management-101 atau #course-1
    const rawHash = window.location.hash.replace('#', '');
    const hash = decodeURIComponent(rawHash);
    const urlParams = new URLSearchParams(window.location.search);
    const targetParam = hash || urlParams.get('course') || urlParams.get('c');

    if (targetParam) {
      const targetCard = document.getElementById(targetParam) || 
                         document.querySelector(`[data-slug="${targetParam}"]`);
      if (targetCard) {
        visibleLimit = 80;
        filterAndSortCourses();
        setTimeout(() => {
          targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
          targetCard.classList.add('ring-4', 'ring-rose-500', 'ring-offset-2');
          setTimeout(() => {
            targetCard.classList.remove('ring-4', 'ring-rose-500', 'ring-offset-2');
          }, 3500);
        }, 300);
      }
    }

    // Terapkan bahasa saat inisialisasi awal
    applyLanguage(currentLang);

  });
</script>
