---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import CourseCard from '../../components/CourseCard.astro';
import coursesData from '../../data/courses.json';

export async function getStaticPaths() {
  const paths = [];

  coursesData.forEach((course) => {
    // 4 kursus rekomendasi dari kategori yang sama
    const related = coursesData
      .filter((c) => (c.slug || c.id) !== (course.slug || course.id) && (c.category === course.category || true))
      .slice(0, 4);

    // Primary route menggunakan slug SEO berbasis judul kursus (https://udemytag.github.io/course/[nama-judul-course]/)
    paths.push({
      params: { slug: course.slug || course.id },
      props: { course, related },
    });

    // Backward compatibility untuk route berbasis id (misal /course/course-1/) jika slug berbeda
    if (course.id && course.slug && course.id !== course.slug) {
      paths.push({
        params: { slug: course.id },
        props: { course, related },
      });
    }
  });

  return paths;
}

const { course, related = [] } = Astro.props;

const pageTitle = `${course.title} - Kupon Diskon 100% Gratis | UdemyTAG`;
const pageDescription = course.description || `Dapatkan akses gratis ke kursus ${course.title} dengan kupon diskon 100% terbaru di UdemyTAG.`;
const courseSlug = course.slug || course.id;
const currentUrl = `https://udemytag.github.io/course/${courseSlug}/`;

const categoryColors: Record<string, { bg: string; text: string; border: string }> = {
  'Development': { bg: 'bg-blue-50 dark:bg-blue-950/60', text: 'text-blue-700 dark:text-blue-300', border: 'border-blue-200 dark:border-blue-800/60' },
  'Business': { bg: 'bg-emerald-50 dark:bg-emerald-950/60', text: 'text-emerald-700 dark:text-emerald-300', border: 'border-emerald-200 dark:border-emerald-800/60' },
  'Design': { bg: 'bg-purple-50 dark:bg-purple-950/60', text: 'text-purple-700 dark:text-purple-300', border: 'border-purple-200 dark:border-purple-800/60' },
  'IT & Software': { bg: 'bg-amber-50 dark:bg-amber-950/60', text: 'text-amber-700 dark:text-amber-300', border: 'border-amber-200 dark:border-amber-800/60' },
  'Marketing': { bg: 'bg-rose-50 dark:bg-rose-950/60', text: 'text-rose-700 dark:text-rose-300', border: 'border-rose-200 dark:border-rose-800/60' },
  'Personal Development': { bg: 'bg-teal-50 dark:bg-teal-950/60', text: 'text-teal-700 dark:text-teal-300', border: 'border-teal-200 dark:border-teal-800/60' },
};

const catStyle = categoryColors[course.category] || {
  bg: 'bg-slate-100 dark:bg-slate-800',
  text: 'text-slate-700 dark:text-slate-300',
  border: 'border-slate-200 dark:border-slate-700'
};

const isFree = course.isFree !== false && !course.isExpired;
const totalClaimed = coursesData.reduce((acc, c) => acc + (c.claimedCount || 0), 0);
const claimed = course.claimedCount || (isFree ? 35 : 100);
const quota = course.quota || 100;
const remainingSlots = course.remainingSlots !== undefined ? course.remainingSlots : Math.max(0, quota - claimed);
const claimPercent = quota > 0 ? Math.min(100, Math.round((claimed / quota) * 100)) : 100;
const subs = course.subscribers || 0;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={course.image}
  courses={[course]}
>
  <Navbar totalCourses={coursesData.length} totalClaimed={totalClaimed} />

  <main class="flex-1 max-w-5xl mx-auto px-3 sm:px-6 lg:px-8 py-6 sm:py-10">
    
    <!-- Breadcrumb Navigation -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-5">
      <a href="/" class="hover:text-rose-600 dark:hover:text-rose-400 flex items-center gap-1 transition-colors">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        <span data-i18n="breadcrumb_home">Beranda</span>
      </a>
      <span>/</span>
      <a href={`/?cat=${course.category.toLowerCase()}#katalog`} class="hover:text-rose-600 dark:hover:text-rose-400 transition-colors">
        {course.category}
      </a>
      <span>/</span>
      <span class="truncate max-w-[200px] text-slate-700 dark:text-slate-200 font-semibold">{course.title}</span>
    </nav>

    <!-- Main Course Presentation -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/90 dark:border-slate-800/90 overflow-hidden shadow-xl">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-0">
        
        <!-- Media Column -->
        <div class="md:col-span-6 relative aspect-video md:aspect-auto overflow-hidden bg-slate-900">
          <img
            src={course.image}
            alt={course.title}
            width="480"
            height="270"
            fetchpriority="high"
            decoding="async"
            class="w-full h-full object-cover"
            onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=800&auto=format&fit=crop&q=80';"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/30 pointer-events-none"></div>

          <!-- Status Badge -->
          {isFree ? (
            <div class="absolute top-3 left-3 flex items-center gap-1.5 px-3 py-1 rounded-xl text-xs font-black bg-emerald-700 text-white shadow-lg shadow-emerald-700/30 uppercase tracking-wider">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
              </svg>
              <span>100% OFF / FREE</span>
            </div>
          ) : (
            <div class="absolute top-3 left-3 flex items-center gap-1.5 px-3 py-1 rounded-xl text-xs font-black bg-slate-900/95 text-amber-300 border border-amber-500/30 shadow-lg uppercase tracking-wider backdrop-blur-md">
              <span>KUOTA HABIS</span>
            </div>
          )}

          <!-- Category Pill -->
          <div class="absolute top-3 right-3">
            <span class={`text-xs font-bold px-3 py-1 rounded-xl border backdrop-blur-md shadow-md ${catStyle.bg} ${catStyle.text} ${catStyle.border}`}>
              {course.category}
            </span>
          </div>

          <!-- Bottom bar on media -->
          <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between text-white text-xs font-bold">
            <div class="flex items-center gap-1 bg-black/70 backdrop-blur-md px-2.5 py-1 rounded-lg">
              <svg class="w-4 h-4 text-amber-400 fill-amber-400" viewBox="0 0 24 24">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
              </svg>
              <span>Rating {course.rating} / 5.0</span>
            </div>

            <div class="flex items-center gap-1.5 bg-black/70 backdrop-blur-md px-2.5 py-1 rounded-lg">
              {isFree ? (
                <>
                  <span class="line-through text-slate-300 text-xs">{course.originalPrice}</span>
                  <span class="free-badge-label text-emerald-400 font-extrabold text-sm uppercase">GRATIS</span>
                </>
              ) : (
                <span class="text-amber-300 font-extrabold text-sm">{course.originalPrice}</span>
              )}
            </div>
          </div>
        </div>

        <!-- Details Column -->
        <div class="md:col-span-6 p-5 sm:p-8 flex flex-col justify-between">
          <div>
            <h1 class="text-lg sm:text-2xl font-extrabold text-slate-900 dark:text-white leading-snug tracking-tight">
              {course.title}
            </h1>

            <p class="mt-3 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
              {course.description}
            </p>

            <!-- Metadata Box -->
            <div class="mt-5 p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-800 grid grid-cols-2 gap-3 text-xs">
              <div>
                <span class="text-slate-400 text-[10px] block" data-i18n="meta_instructor_label">Instruktur</span>
                <span class="font-bold text-slate-800 dark:text-slate-200 truncate block" title={course.instructor}>{course.instructor}</span>
              </div>
              <div>
                <span class="text-slate-400 text-[10px] block" data-i18n="meta_coupon_label">Kode Kupon</span>
                <span class="font-mono font-bold text-rose-600 dark:text-rose-400 truncate block">{course.coupon}</span>
              </div>
              <div>
                <span class="text-slate-400 text-[10px] block" data-i18n="meta_claim_label">Status Kupon</span>
                {isFree ? (
                  <span class="font-bold text-emerald-700 dark:text-emerald-400">100% Aktif & Legal</span>
                ) : (
                  <span class="font-bold text-rose-700 dark:text-rose-400">Kuota Habis (Expired)</span>
                )}
              </div>
              {subs > 0 ? (
                <div>
                  <span class="text-slate-400 text-[10px] block">Siswa di Udemy</span>
                  <span class="font-bold text-blue-600 dark:text-blue-400">{subs.toLocaleString()} Murid</span>
                </div>
              ) : (
                <div>
                  <span class="text-slate-400 text-[10px] block" data-i18n="meta_access_label">Akses</span>
                  <span class="font-bold text-slate-800 dark:text-slate-200" data-i18n="meta_access_val">Seumur Hidup (Lifetime)</span>
                </div>
              )}
            </div>

            <!-- Live Claim Quota & Real Urgency Indicator -->
            {isFree ? (
              <div class="mt-4 p-3.5 rounded-2xl bg-gradient-to-r from-rose-50/70 via-amber-50/40 to-rose-50/70 dark:from-rose-950/40 dark:via-amber-950/20 dark:to-rose-950/40 border border-rose-200/80 dark:border-rose-900/60 shadow-sm">
                <div class="flex items-center justify-between text-xs mb-1.5">
                  <span class="flex items-center gap-1.5 font-bold text-rose-700 dark:text-rose-300">
                    <span class="text-sm">🔥</span>
                    <span><strong class="card-claimed-number font-black text-rose-600 dark:text-rose-400" data-course-id={course.id} data-base={claimed}>{claimed}</strong> <span data-i18n="detail_claimed_headline">Orang Telah Mengklaim</span></span>
                  </span>
                  <span class="text-[11px] font-semibold text-slate-600 dark:text-slate-300">
                    <span data-i18n="quota_prefix">Sisa</span> <strong class="card-remaining-number font-black text-rose-600 dark:text-rose-400" data-course-id={course.id}>{remainingSlots}</strong> <span data-i18n="quota_suffix">Slot</span>
                  </span>
                </div>

                <!-- Animated Progress Bar -->
                <div class="w-full h-2 bg-slate-200/80 dark:bg-slate-800 rounded-full overflow-hidden shadow-inner">
                  <div 
                    class="card-claim-bar h-full bg-gradient-to-r from-rose-500 via-rose-600 to-amber-500 rounded-full transition-all duration-500" 
                    data-course-id={course.id}
                    data-quota={quota}
                    style={`width: ${claimPercent}%`}
                  ></div>
                </div>

                <div class="flex items-center justify-between text-[10px] text-slate-500 dark:text-slate-400 mt-1.5">
                  <span data-i18n="detail_claim_hint">⚡ Kuota promo terbatas dari instruktur</span>
                  <span>{claimPercent}% <span data-i18n="detail_quota_filled">Terisi</span></span>
                </div>
              </div>
            ) : (
              <div class="mt-4 p-3.5 rounded-2xl bg-amber-50/80 dark:bg-amber-950/30 border border-amber-200/80 dark:border-amber-900/50 shadow-sm text-xs">
                <div class="flex items-center gap-2 font-bold text-amber-800 dark:text-amber-300 mb-1">
                  <svg class="w-4 h-4 text-amber-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                  </svg>
                  <span>Kuota Kupon Gratis 100% Telah Habis di Udemy</span>
                </div>
                <p class="text-[11px] text-slate-600 dark:text-slate-400 leading-relaxed">
                  Kupon promosi untuk kursus ini telah mencapai batas kuota penukaran instruktur. Harga kursus saat ini telah kembali ke harga normal ({course.originalPrice}).
                </p>
              </div>
            )}
          </div>

          <!-- Actions -->
          <div class="mt-6 space-y-3 pt-4 border-t border-slate-100 dark:border-slate-800">
            
            <!-- Direct CTA to Udemy -->
            <a
              href={course.url}
              target="_blank"
              rel="noopener noreferrer"
              class={`claim-action-trigger w-full inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-2xl text-sm font-extrabold transition-all text-center ${
                isFree 
                  ? 'bg-gradient-to-r from-rose-600 to-rose-700 hover:from-rose-500 hover:to-rose-600 text-white shadow-lg shadow-rose-600/30 active:scale-[0.98]' 
                  : 'bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200'
              }`}
              data-course-id={course.id}
            >
              <span>{isFree ? 'Klaim Sekarang di Udemy (Gratis)' : 'Buka Halaman Kursus di Udemy'}</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>

            <!-- Sub Actions: Salin Kupon & Salin Link -->
            <div class="grid grid-cols-2 gap-2">
              
              <!-- Salin Kupon -->
              <button
                type="button"
                id="copy-coupon-detail-btn"
                aria-label={`Salin Kode Kupon: ${course.title}`}
                class="claim-action-trigger inline-flex items-center justify-center gap-1.5 px-3 py-2.5 rounded-xl text-xs font-bold border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-all active:scale-95"
                data-coupon={course.coupon}
                data-course-id={course.id}
              >
                <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2" stroke-width="2"/>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" stroke-width="2"/>
                </svg>
                <span id="copy-coupon-text">Salin Kode Kupon</span>
              </button>

              <!-- Salin Link (Tanpa Popup Toast) -->
              <button
                type="button"
                id="share-page-btn"
                class="inline-flex items-center justify-center gap-1.5 px-3 py-2.5 rounded-xl text-xs font-bold border border-blue-200 dark:border-blue-900/60 bg-blue-50 dark:bg-blue-950/40 text-blue-700 dark:text-blue-300 hover:bg-blue-100 dark:hover:bg-blue-900/60 transition-all active:scale-95"
                data-url={currentUrl}
                title="Salin Link"
                aria-label={`Salin Link: ${course.title}`}
              >
                <svg id="share-icon" class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                  <path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92c0-1.61-1.31-2.92-2.92-2.92z"/>
                </svg>
                <svg id="share-check-icon" class="hidden w-3.5 h-3.5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
                <span id="share-btn-text">Salin Link</span>
              </button>

            </div>

          </div>

        </div>

      </div>
    </div>

    <!-- Banner Kembali ke Beranda / Semua Kursus -->
    <div class="mt-8 p-4 sm:p-6 rounded-3xl bg-gradient-to-r from-rose-500/10 via-amber-500/10 to-transparent border border-rose-200/60 dark:border-rose-900/40 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <h2 class="text-sm sm:text-base font-extrabold text-slate-900 dark:text-white" data-i18n="banner_more_title">
          Ingin Belajar Topik Lainnya?
        </h2>
        <p class="text-xs text-slate-600 dark:text-slate-400 mt-0.5" data-i18n="banner_more_desc">
          Tersedia 80+ kursus gratis Udemy bersertifikat lainnya yang siap Anda klaim hari ini.
        </p>
      </div>
      <a
        href="/"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-800 dark:text-slate-200 hover:text-rose-600 dark:hover:text-rose-400 shadow-sm transition-all flex-shrink-0"
      >
        <span data-i18n="banner_more_btn">Lihat Semua Kursus</span>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>

    <!-- Related Courses Section -->
    {related.length > 0 && (
      <section class="mt-12">
        <div class="flex items-center justify-between mb-5">
          <h2 class="text-base sm:text-xl font-extrabold text-slate-900 dark:text-white" data-i18n="related_section_title">
            Kursus Pilihan Terkait
          </h2>
          <a href="/#katalog" class="text-xs font-bold text-rose-600 dark:text-rose-400 hover:underline" data-i18n="related_view_all">
            Lihat Katalog Lengkap &rarr;
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5 sm:gap-5">
          {related.map((rel) => (
            <CourseCard course={rel} />
          ))}
        </div>
      </section>
    )}

  </main>

  <Footer />

</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Salin Kode Kupon Halaman Detail
    const copyCouponBtn = document.getElementById('copy-coupon-detail-btn');
    const copyCouponText = document.getElementById('copy-coupon-text');

    copyCouponBtn?.addEventListener('click', async () => {
      const coupon = copyCouponBtn.getAttribute('data-coupon') || '';
      const isEn = document.documentElement.lang === 'en';
      try {
        await navigator.clipboard.writeText(coupon);
        if (copyCouponText) copyCouponText.textContent = isEn ? 'Coupon Copied!' : 'Kupon Tersalin!';
        if (window.showToast) {
          window.showToast(isEn ? `Coupon "${coupon}" copied to clipboard!` : `Kode kupon "${coupon}" berhasil disalin!`);
        }
        setTimeout(() => {
          if (copyCouponText) copyCouponText.textContent = isEn ? 'Copy Coupon Code' : 'Salin Kode Kupon';
        }, 2000);
      } catch (_) {}
    });

    // 2. Salin Link Halaman Kursus (Tanpa Popup Toast)
    const sharePageBtn = document.getElementById('share-page-btn');
    const shareBtnText = document.getElementById('share-btn-text');
    const shareIcon = document.getElementById('share-icon');
    const shareCheckIcon = document.getElementById('share-check-icon');

    sharePageBtn?.addEventListener('click', async () => {
      const url = sharePageBtn.getAttribute('data-url') || window.location.href;
      const isEn = document.documentElement.lang === 'en';
      try {
        await navigator.clipboard.writeText(url);
        if (shareBtnText) shareBtnText.textContent = isEn ? 'Link Copied!' : 'Link Tersalin!';
        shareIcon?.classList.add('hidden');
        shareCheckIcon?.classList.remove('hidden');
        sharePageBtn.classList.add('border-emerald-600', 'text-emerald-700', 'dark:text-emerald-400');

        setTimeout(() => {
          if (shareBtnText) shareBtnText.textContent = isEn ? 'Copy Link' : 'Salin Link';
          shareIcon?.classList.remove('hidden');
          shareCheckIcon?.classList.add('hidden');
          sharePageBtn.classList.remove('border-emerald-600', 'text-emerald-700', 'dark:text-emerald-400');
        }, 2000);
      } catch (_) {}
    });

    // 3. Salin Kupon & Link untuk Kartu Kursus Terkait di Bawah
    document.querySelectorAll('.copy-coupon-btn').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        const coupon = btn.getAttribute('data-coupon') || '';
        const copyIcon = btn.querySelector('.copy-icon');
        const checkIcon = btn.querySelector('.check-icon');
        const btnText = btn.querySelector('.btn-text');
        const isEn = document.documentElement.lang === 'en';

        try {
          await navigator.clipboard.writeText(coupon);
          copyIcon?.classList.add('hidden');
          checkIcon?.classList.remove('hidden');
          if (btnText) btnText.textContent = isEn ? 'Copied!' : 'Tersalin!';
          btn.classList.add('border-emerald-500', 'text-emerald-600', 'dark:text-emerald-400');
          if (window.showToast) {
            window.showToast(isEn ? `Coupon "${coupon}" copied!` : `Kupon "${coupon}" disalin!`);
          }
          setTimeout(() => {
            copyIcon?.classList.remove('hidden');
            checkIcon?.classList.add('hidden');
            if (btnText) btnText.textContent = isEn ? 'Copy Coupon' : 'Salin Kupon';
            btn.classList.remove('border-emerald-500', 'text-emerald-600', 'dark:text-emerald-400');
          }, 2000);
        } catch (_) {}
      });
    });

    document.querySelectorAll('.copy-post-link-btn').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const link = btn.getAttribute('data-link') || '';
        const linkIcon = btn.querySelector('.link-icon');
        const checkIcon = btn.querySelector('.link-check-icon');
        const linkText = btn.querySelector('.link-btn-text');
        const isEn = document.documentElement.lang === 'en';

        try {
          await navigator.clipboard.writeText(link);
          linkIcon?.classList.add('hidden');
          checkIcon?.classList.remove('hidden');
          if (linkText) linkText.textContent = isEn ? 'Copied!' : 'Tersalin!';
          btn.classList.add('border-emerald-500', 'text-emerald-600', 'dark:text-emerald-400');

          setTimeout(() => {
            linkIcon?.classList.remove('hidden');
            checkIcon?.classList.add('hidden');
            if (linkText) linkText.textContent = isEn ? 'Copy Link' : 'Salin Link';
            btn.classList.remove('border-emerald-500', 'text-emerald-600', 'dark:text-emerald-400');
          }, 2000);
        } catch (_) {}
      });
    });
  });
</script>
